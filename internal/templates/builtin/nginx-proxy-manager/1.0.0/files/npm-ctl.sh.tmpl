#!/bin/sh
# Beheerd door ClusterForge (cluster {{ .cluster.slug }}).
#
# Nginx Proxy Manager als cluster. NPM draait alleen op de node met het VIP
# ({{ .params.vip }}). Elke paar minuten maakt die node een consistente kopie
# (snapshot) en zet ClusterForge die met de sync NPM-configuratie op de andere
# nodes, in $IN. Krijgt een node het VIP, dan zet hij eerst de nieuwste
# geldige kopie op zijn plaats en start dan NPM.
#
#   npm-ctl.sh up | down        NPM starten of stoppen (via cf-npm, systemd)
#   npm-ctl.sh snapshot         de kopie voor de sync maken (alleen op de VIP-node)
#   npm-ctl.sh check            keepalived: mag deze node het VIP hebben?
#   npm-ctl.sh master | backup  keepalived: deze node kreeg of verloor het VIP
#   npm-ctl.sh status           wat er op deze node staat
#   npm-ctl.sh pull | pulled    het image van NPM halen / staat het er?
#   npm-ctl.sh unchanged        draait NPM hier met de huidige image en compose.yaml?
#   npm-ctl.sh restart-if-changed
#   npm-ctl.sh overnemen [<map> [letsencrypt-map]]
#                               een bestaande NPM naar het cluster; zonder map die
#                               die hier draait (mappen uit zijn mounts)
#
# Waarom zo: SQLite mag je niet kopiëren terwijl NPM erin schrijft, en een
# database vervangen onder een draaiende NPM geeft "attempt to write a
# readonly database". Daarom draait NPM nooit op een node die een kopie
# ontvangt, maakt sqlite3 .backup de kopie, en komt een ontvangen kopie er
# alleen in vóór NPM start, zonder de -wal/-shm/-journal van de vorige.
set -u
# CF_NPM_BASE en CF_NPM_STATE zijn er alleen voor de tests van ClusterForge.
BASE=${CF_NPM_BASE:-/opt/cf-npm}
DATA=$BASE/data
LE=$BASE/letsencrypt
DB=$DATA/database.sqlite
STATE=${CF_NPM_STATE:-/var/lib/cf-npm}
OUT=$STATE/outgoing
IN=$STATE/incoming
# STAMP: tot wanneer de data hier zeker actueel is (seconden sinds 1970). Een
# ontvangen kopie die niet nieuwer is, komt er niet in.
STAMP=$STATE/stamp
HASH=${CF_NPM_HASH:-/run/cf-npm.hash}
VIP='{{ .params.vip }}'
IMAGE='{{ .params.npm_image }}'
ADMIN='{{ .params.admin_port }}'
# Gezondheid op de VIP-node: STARTED is wanneer NPM hier startte (na GRACE
# seconden moet de API antwoorden), UNHEALTHY telt de checks op rij waarin
# NPM niet draaide of niet antwoordde.
STARTED=$STATE/started
UNHEALTHY=$STATE/unhealthy
GRACE=180
# De eerste node mag NPM leeg starten (een nieuw cluster); een andere node
# alleen met een configuratie, anders zou een lege NPM bron van de sync worden.
INDEX='{{ .node.index }}'
IFACE='{{ .node.interface }}'
# De nodes met een hogere prioriteit (lagere index). Hebben zo'n node en deze
# allebei het VIP (ze horen elkaars VRRP niet, bv. door een firewall), dan
# geeft deze node het af: zie better_has_vip en check.
BETTER='{{ range .peers }}{{ if lt .index $.node.index }}{{ .address }} {{ end }}{{ end }}'
YIELD=$STATE/yielded

compose() { docker compose -p cf-npm --project-directory "$BASE" -f "$BASE/compose.yaml" "$@"; }
has_vip() { ip -o addr show | grep -q " $VIP/"; }
running() { [ "$(docker inspect -f '{{"{{"}}.State.Running{{"}}"}}' cf-npm 2>/dev/null)" = true ]; }
say() { echo "== $*"; }
warn() { echo "WAARSCHUWING: $*" >&2; }
fail() { echo "FOUT: $*" >&2; exit 1; }
when() { date -d "@$1" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || echo "$1"; }
field() { sed -n "s/^$1=//p" "$2" 2>/dev/null | head -n 1; }
# Het adres van een node met een hogere prioriteit die het VIP ook heeft
# (arping in DAD-modus: wie antwoordt, heeft het adres).
better_has_vip() {
  [ -n "$BETTER" ] || return 1
  macs=$(arping -D -c 2 -w 3 -I "$IFACE" "$VIP" 2>/dev/null |
    sed -n 's/.*\[\([0-9A-Fa-f:]*\)\].*/\1/p' | tr 'A-F' 'a-f')
  [ -n "$macs" ] || return 1
  for p in $BETTER; do
    ping -c 1 -W 1 "$p" >/dev/null 2>&1
    mac=$(ip neigh show "$p" 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "lladdr") print tolower($(i + 1))}')
    if [ -n "$mac" ] && echo "$macs" | grep -qx "$mac"; then
      echo "$p"
      return 0
    fi
  done
  return 1
}
# Draait de container van NPM en antwoordt zijn API?
healthy() { running && curl -fsS -m 4 -o /dev/null "http://127.0.0.1:$ADMIN/api/" 2>/dev/null; }
log() { logger -t cf-npm "$*" 2>/dev/null; echo "$*" >&2; }
integrity() { [ "$(sqlite3 "$1" 'PRAGMA integrity_check;' 2>&1)" = ok ]; }
# De containers van een andere NPM op deze machine (zoals de NPM die je nog
# moet overnemen); die houdt poort 80 en 443 vast.
foreign() {
  docker ps --format '{{"{{"}}.ID{{"}}"}} {{"{{"}}.Image{{"}}"}} {{"{{"}}.Label "com.docker.compose.project"{{"}}"}}' 2>/dev/null |
    awk '$2 ~ /nginx-proxy-manager/ && $3 != "cf-npm" {print $1}'
}
fingerprint() {
  { cat "$BASE/compose.yaml"; docker image inspect -f '{{"{{"}}.Id{{"}}"}}' "$IMAGE" 2>/dev/null; } | sha256sum | cut -d' ' -f1
}

# De ontvangen kopie op zijn plaats zetten, als ze nieuwer is dan wat hier
# staat en volledig klopt. Anders start NPM met wat hier staat.
install_incoming() {
  if [ ! -f "$IN/MANIFEST" ]; then
    echo "Geen ontvangen kopie; NPM start met wat hier staat."
    return 0
  fi
  created=$(field created "$IN/MANIFEST")
  from=$(field host "$IN/MANIFEST")
  case "$created" in
    '' | *[!0-9]*) warn "ongeldige $IN/MANIFEST; NPM start met wat hier staat"; return 0 ;;
  esac
  stamp=$(cat "$STAMP" 2>/dev/null || echo 0)
  case "$stamp" in '' | *[!0-9]*) stamp=0 ;; esac
  if [ "$created" -le "$stamp" ]; then
    echo "De data hier ($(when "$stamp")) is niet ouder dan de kopie van $from ($(when "$created")); niets overgezet."
    return 0
  fi
  if ! (cd "$IN" && sha256sum --quiet --strict -c SHA256SUMS >/dev/null 2>&1); then
    warn "de kopie van $from ($(when "$created")) is onvolledig (sync onderbroken?); NPM start met wat hier staat"
    return 0
  fi
  if ! integrity "$IN/data/database.sqlite"; then
    warn "de database in de kopie van $from is niet in orde (integrity_check); NPM start met wat hier staat"
    return 0
  fi
  say "Kopie van $from ($(when "$created")) op zijn plaats zetten"
  # De -wal, -shm en -journal horen bij de vorige database: weg, anders past
  # SQLite ze toe op de nieuwe of opent hij haar alleen-lezen.
  rm -f "$DB-wal" "$DB-shm" "$DB-journal"
  # --checksum: een database met dezelfde grootte en tijd is nog niet dezelfde.
  rsync -a --checksum --delete --exclude=/logs/ "$IN/data/" "$DATA/" || fail "rsync naar $DATA"
  rsync -a --checksum --delete "$IN/letsencrypt/" "$LE/" || fail "rsync naar $LE"
  echo "$created" > "$STAMP"
}

# Een consistente kopie maken in $OUT, voor de sync. Alleen op de VIP-node
# waar NPM draait; faalt er iets, dan houden de andere nodes hun vorige kopie.
snapshot() {
  has_vip || fail "deze node heeft het VIP $VIP niet; alleen de VIP-node maakt de kopie"
  systemctl is-active --quiet cf-npm || fail "NPM draait hier niet (systemctl status cf-npm); geen kopie, de andere nodes houden hun vorige"
  [ -f "$DB" ] || fail "$DB ontbreekt; is NPM al eens gestart?"
  t=$(date +%s)
  new=$STATE/outgoing.new
  rm -rf "$new" && mkdir -p "$new/data" "$new/letsencrypt" && chmod 0700 "$new" || fail "map $new"
  # Online backup van SQLite: klopt ook terwijl NPM schrijft.
  sqlite3 "$DB" '.timeout 30000' ".backup '$new/data/database.sqlite'" || fail "sqlite3 .backup"
  integrity "$new/data/database.sqlite" || fail "de kopie van de database is niet in orde (integrity_check)"
  rsync -a --exclude='/database.sqlite*' --exclude=/logs/ "$DATA/" "$new/data/" || fail "rsync van $DATA"
  rsync -a "$LE/" "$new/letsencrypt/" || fail "rsync van $LE"
  printf 'created=%s\nhost=%s\nimage=%s\n' "$t" "$(hostname)" "$IMAGE" > "$new/MANIFEST"
  (cd "$new" && find data letsencrypt MANIFEST -type f -print0 | sort -z | xargs -0 -r sha256sum) > "$new/SHA256SUMS" || fail "sha256sum"
  rm -rf "$OUT.old"
  if [ -d "$OUT" ]; then mv "$OUT" "$OUT.old" || fail "mv $OUT"; fi
  mv "$new" "$OUT" || fail "mv $new"
  rm -rf "$OUT.old"
  echo "$t" > "$STAMP"
  echo "Kopie van $(when "$t"): $(wc -l < "$OUT/SHA256SUMS") bestanden, database $(du -h "$OUT/data/database.sqlite" | cut -f1)."
}

# Een bestaande NPM naar het cluster halen, op de VIP-node.
overnemen() {
  if [ -n "${1:-}" ]; then
    srcdata=${1%/}/data
    le=${2:-${1%/}/letsencrypt}
  else
    # Zonder map: de mappen van de andere NPM die hier draait, uit zijn mounts.
    c=$(foreign | head -n 1)
    [ -n "$c" ] || fail "hier draait geen andere NPM; geef de map: $0 overnemen <map met data/ en letsencrypt/>"
    mounts=$(docker inspect -f '{{"{{"}}range .Mounts{{"}}"}}{{"{{"}}.Destination{{"}}"}} {{"{{"}}.Source{{"}}"}}{{"{{"}}"\n"{{"}}"}}{{"{{"}}end{{"}}"}}' "$c")
    srcdata=$(echo "$mounts" | awk '$1 == "/data" {print $2}')
    le=$(echo "$mounts" | awk '$1 == "/etc/letsencrypt" {print $2}')
    echo "Andere NPM $c: data in $srcdata, certificaten in ${le:-(geen)}"
    [ -n "$le" ] || { le=$STATE/geen-letsencrypt; mkdir -p "$le"; }
  fi
  srcdata=${srcdata%/}
  [ -f "$srcdata/database.sqlite" ] || fail "geen $srcdata/database.sqlite"
  [ -d "$le" ] || fail "geen map $le met de certificaten"
  has_vip || fail "doe dit op de node met het VIP ($VIP)"
  command -v sqlite3 >/dev/null || fail "sqlite3 ontbreekt"
  # Een oude NPM op deze machine houdt poort 80 en 443 vast: stoppen, en
  # niet meer vanzelf laten starten.
  old=$(foreign)
  say "NPM van het cluster stoppen"
  systemctl stop cf-npm
  if [ -n "$old" ]; then
    say "Oude NPM stoppen ($old); start niet meer vanzelf"
    # shellcheck disable=SC2086
    docker update --restart=no $old >/dev/null && docker stop $old >/dev/null || fail "oude NPM stoppen"
  fi
  say "Database kopiëren (sqlite3 .backup)"
  rm -f "$DB" "$DB-wal" "$DB-shm" "$DB-journal"
  sqlite3 "$srcdata/database.sqlite" '.timeout 30000' ".backup '$DB'" || fail "sqlite3 .backup"
  integrity "$DB" || fail "de overgenomen database is niet in orde (integrity_check)"
  say "Rest van data/ en de certificaten kopiëren"
  rsync -a --delete --exclude='/database.sqlite*' --exclude=/logs/ "$srcdata/" "$DATA/" || fail "rsync data"
  rsync -a --delete "${le%/}/" "$LE/" || fail "rsync letsencrypt"
  # Wat hier staat, is nu nieuwer dan elke ontvangen kopie.
  date +%s > "$STAMP"
  say "NPM van het cluster starten"
  systemctl start cf-npm || fail "systemctl start cf-npm (journalctl -u cf-npm)"
  echo "Overgenomen. Binnen enkele minuten staat de eerste kopie op de andere nodes (Cronjobs, NPM-configuratie)."
  [ -n "$old" ] && echo "Terug naar de oude NPM: systemctl stop cf-npm; docker start $(echo $old)"
  return 0
}

status() {
  echo "node:      $(hostname)"
  if has_vip; then echo "VIP:       $VIP staat hier"; else echo "VIP:       $VIP staat elders"; fi
  echo "cf-npm:    $(systemctl is-active cf-npm 2>/dev/null)"
  if running; then
    if healthy; then echo "NPM:       draait, API antwoordt"; else echo "NPM:       draait, API antwoordt NIET (poort $ADMIN)"; fi
  fi
  [ -n "$(foreign)" ] && echo "LET OP:    een andere NPM draait hier: $(foreign | tr '\n' ' ')"
  echo "data:      actueel tot $(when "$(cat "$STAMP" 2>/dev/null || echo 0)")"
  [ -f "$OUT/MANIFEST" ] && echo "verstuurd: kopie van $(when "$(field created "$OUT/MANIFEST")")"
  [ -f "$IN/MANIFEST" ] && echo "ontvangen: kopie van $(field host "$IN/MANIFEST") van $(when "$(field created "$IN/MANIFEST")")"
  return 0
}

case "${1:-}" in
  up)
    # Een andere NPM hier (nog niet overgenomen) houdt de poorten vast en
    # bedient het VIP zelf: niet starten.
    if [ -n "$(foreign)" ]; then
      fail "hier draait nog een andere NPM ($(foreign | tr '\n' ' ')); neem hem over met: $0 overnemen <map>"
    fi
    # Nooit over een draaiende NPM heen kopiëren.
    compose rm -sf >/dev/null 2>&1
    install_incoming
    if [ ! -f "$DB" ] && [ "$INDEX" != 1 ] && [ ! -f "$STATE/allow-empty" ]; then
      fail "hier staat nog geen configuratie (geen kopie ontvangen); NPM start niet leeg op deze node. Wil je toch een lege NPM hier: touch $STATE/allow-empty"
    fi
    fingerprint > "$HASH"
    date +%s > "$STARTED"
    rm -f "$UNHEALTHY"
    exec docker compose -p cf-npm --project-directory "$BASE" -f "$BASE/compose.yaml" up --no-build --remove-orphans
    ;;
  down)
    # NPM draaide hier tot nu: wat hier staat, is het nieuwste.
    if running; then date +%s > "$STAMP"; fi
    compose stop
    rm -f "$HASH"
    ;;
  snapshot)
    snapshot
    ;;
  check)
    systemctl is-active --quiet docker || exit 1
    # Draait NPM hier maar faalt het, dan geeft deze node het VIP af.
    systemctl is-failed --quiet cf-npm && exit 1
    # Een andere NPM terwijl hier al een configuratie van het cluster staat:
    # een overblijfsel (bv. de oude NPM na een herstart). Die houdt de poorten
    # vast met oude data; deze node mag het VIP dan niet hebben.
    if [ -n "$(foreign)" ] && [ -f "$DB" ]; then
      log "een andere NPM draait hier ($(foreign | tr '\n' ' ')); deze node geeft het VIP af. Weghalen: docker rm -f <id>"
      exit 1
    fi
    # Split-brain: heeft een node met een hogere prioriteit het VIP ook, dan
    # geeft deze node het af (FAULT, NPM stopt) tot die node het niet meer
    # heeft. Zonder VIP alleen nakijken als deze node daarvoor afgaf.
    if has_vip || [ -f "$YIELD" ]; then
      if peer=$(better_has_vip); then
        [ -f "$YIELD" ] || log "split-brain: $peer heeft het VIP $VIP ook, deze node geeft het af"
        date +%s > "$YIELD"
        exit 1
      fi
      rm -f "$YIELD"
    fi
    if ! has_vip; then
      # NPM draait alleen op de node met het VIP; een NPM die hier nog draait
      # (gemiste notify, keepalived herstart) zou oude data tonen.
      if systemctl is-active --quiet cf-npm; then
        log "NPM draait hier zonder het VIP; stoppen"
        systemctl stop --no-block cf-npm
      elif running; then
        # Buiten systemd gestart (docker start, compose up -d): ook stoppen.
        log "de container cf-npm draait hier zonder het VIP en buiten cf-npm.service; stoppen"
        compose stop >/dev/null 2>&1
      fi
      rm -f "$UNHEALTHY"
      exit 0
    fi
    # Na een herstart, of als de container stopte, start de node met het VIP
    # NPM opnieuw; niet zolang hier nog een andere NPM draait (die bedient
    # het VIP tot de overname).
    if ! systemctl is-active --quiet cf-npm; then
      [ -z "$(foreign)" ] && systemctl start --no-block cf-npm
      exit 0
    fi
    # NPM draait volgens systemd: antwoordt het ook? Na de opstarttijd geeft
    # deze node het VIP af als NPM 3 checks op rij (±10 s) niet draait of niet
    # antwoordt; de andere node neemt dan over met de laatste kopie.
    started=$(cat "$STARTED" 2>/dev/null || echo 0)
    if [ $(($(date +%s) - started)) -lt "$GRACE" ] || healthy; then
      rm -f "$UNHEALTHY"
      exit 0
    fi
    n=$(($(cat "$UNHEALTHY" 2>/dev/null || echo 0) + 1))
    echo "$n" > "$UNHEALTHY"
    if [ "$n" -ge 3 ]; then
      log "NPM draait niet of antwoordt niet op poort $ADMIN ($n checks); deze node geeft het VIP af"
      exit 1
    fi
    exit 0
    ;;
  master)
    [ -z "$(foreign)" ] && systemctl start --no-block cf-npm
    exit 0
    ;;
  backup)
    systemctl stop --no-block cf-npm
    rm -f "$UNHEALTHY"
    # Een gefaalde NPM mag later weer: de node kan het VIP dan terugkrijgen.
    systemctl reset-failed cf-npm 2>/dev/null
    exit 0
    ;;
  status)
    status
    ;;
  pull)
    docker pull "$IMAGE"
    ;;
  pulled)
    docker image inspect "$IMAGE" >/dev/null 2>&1
    ;;
  unchanged)
    systemctl is-active --quiet cf-npm || exit 0
    [ "$(cat "$HASH" 2>/dev/null)" = "$(fingerprint)" ]
    ;;
  restart-if-changed)
    systemctl try-restart cf-npm
    ;;
  overnemen)
    shift
    overnemen "$@"
    ;;
  *)
    echo "gebruik: $0 up|down|snapshot|check|master|backup|status|pull|pulled|unchanged|restart-if-changed|overnemen" >&2
    exit 2
    ;;
esac
