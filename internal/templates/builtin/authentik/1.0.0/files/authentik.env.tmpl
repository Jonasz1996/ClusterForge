# Beheerd door ClusterForge (cluster {{ .cluster.slug }}). Wijzigingen hier
# worden bij de volgende uitrol overschreven.
#
# Voor server en worker van Authentik en voor authentik-ctl.sh. De geheime
# sleutel staat hier niet: authentik-ctl.sh up zet hem in
# /run/cf-authentik/key.env (de overgenomen sleutel als die er is).
AUTHENTIK_POSTGRESQL__HOST={{ .params.db_vip }}
AUTHENTIK_POSTGRESQL__PORT=5432
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD={{ .params.db_password }}
# Na een failover van Patroni zijn open verbindingen dood: nakijken voor
# hergebruik.
AUTHENTIK_POSTGRESQL__CONN_HEALTH_CHECKS=true
# Alleen voor versies van vóór 2025.10; nieuwere gebruiken geen Redis.
AUTHENTIK_REDIS__HOST=redis
AUTHENTIK_ERROR_REPORTING__ENABLED=false
