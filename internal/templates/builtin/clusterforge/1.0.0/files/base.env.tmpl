# Beheerd door ClusterForge (cluster {{ .cluster.slug }}). Wijzigingen hier
# worden bij de volgende uitrol overschreven. Rechten 0600 (root).
#
# clusterforge-ctl.sh maakt hiermee /etc/cf-clusterforge/server.env: de
# instellingen van de oude server (na de verhuizing), met daarover deze.
CF_DATABASE_URL=postgres://clusterforge:{{ .params.db_password }}@{{ .params.db_vip }}:5432/clusterforge?sslmode=disable
CF_LISTEN=:8080
CF_NATS_LISTEN=:4222
CF_HTTP_BIND=0.0.0.0
CF_NATS_ADVERTISE={{ .params.vip }}
CF_VICTORIAMETRICS_URL=http://127.0.0.1:8428
CF_VICTORIAMETRICS_MIRRORS={{ range $i, $p := .peers }}{{ if $i }},{{ end }}http://{{ $p.address }}:8428{{ end }}
CF_SELF_CLUSTER={{ .cluster.slug }}
CF_MASTER_KEY_FILE=/etc/clusterforge/master.key
TZ={{ .params.timezone }}
