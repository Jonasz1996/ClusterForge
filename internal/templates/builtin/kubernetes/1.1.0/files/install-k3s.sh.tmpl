#!/bin/sh
# Beheerd door ClusterForge (cluster {{ .cluster.slug }}). Wijzigingen hier
# worden bij de volgende uitrol overschreven.
#
# Installeert k3s uit de GitHub-release en controleert de SHA-256 met het
# controlebestand van dezelfde release, zoals het officiële installatiescript
# van k3s doet. Daarna zet het een merkteken met de versie ernaast, waaraan
# ClusterForge ziet dat deze versie er staat.
set -eu

VERSION='v1.36.5+k3s1'
URL='https://github.com/k3s-io/k3s/releases/download/v1.36.5%2Bk3s1'

case "$(uname -m)" in
x86_64 | amd64) BIN=k3s SUMS=sha256sum-amd64.txt ;;
aarch64 | arm64) BIN=k3s-arm64 SUMS=sha256sum-arm64.txt ;;
*)
    echo "k3s draait niet op een $(uname -m)-processor" >&2
    exit 1
    ;;
esac

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
echo "k3s $VERSION downloaden"
curl -fsSL --retry 3 -o "$TMP/$BIN" "$URL/$BIN"
curl -fsSL --retry 3 -o "$TMP/$SUMS" "$URL/$SUMS"
(cd "$TMP" && grep " $BIN\$" "$SUMS" | sha256sum -c -)
# Eerst ernaast en dan hernoemen, zodat een draaiende k3s niet halverwege
# een half bestand ziet.
install -m 0755 "$TMP/$BIN" /usr/local/bin/k3s.new
mv -f /usr/local/bin/k3s.new /usr/local/bin/k3s
/usr/local/bin/k3s --version | head -n 1
touch "/usr/local/lib/clusterforge/k3s-$VERSION"
