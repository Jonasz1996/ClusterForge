# Beheerd door ClusterForge (cluster {{ .cluster.slug }}). Wijzigingen hier
# worden bij de volgende uitrol overschreven.

global_defs {
    router_id {{ .node.hostname }}
    enable_script_security
    script_user root
}

# Antwoordt de homepage hier niet (nginx en de api), dan geeft deze node
# het VIP af; de worker (alle checks) volgt het VIP. nopreempt: een gezonde
# VIP-node houdt het VIP, zodat de checks niet onnodig verhuizen.
vrrp_script chk_homepage {
    script "/usr/local/lib/clusterforge/homepage-ctl.sh check"
    interval 3
    timeout 8
    fall 2
    rise 2
}

vrrp_instance VI_{{ .params.vrid }} {
    state BACKUP
    nopreempt
    interface {{ .node.interface }}
    virtual_router_id {{ .params.vrid }}
    priority {{ sub 160 (mul .node.index 10) }}
    advert_int 1
    unicast_src_ip {{ .node.address }}
    unicast_peer {
{{- range .peers }}
        {{ .address }}
{{- end }}
    }
    authentication {
        auth_type PASS
        auth_pass {{ .params.auth_pass }}
    }
    virtual_ipaddress {
        {{ .params.vip }}/{{ .node.prefix }} dev {{ .node.interface }}
    }
    track_script {
        chk_homepage
    }
    notify_master "/usr/local/lib/clusterforge/homepage-ctl.sh master"
    notify_backup "/usr/local/lib/clusterforge/homepage-ctl.sh vip-weg"
    notify_fault "/usr/local/lib/clusterforge/homepage-ctl.sh vip-weg"
}

# Het eigen VIP van PostgreSQL (ClusterForge, Database).
include /etc/keepalived/conf.d/*.conf
