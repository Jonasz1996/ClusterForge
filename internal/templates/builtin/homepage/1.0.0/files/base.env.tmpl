# Beheerd door ClusterForge (cluster {{ .cluster.slug }}). Wijzigingen hier
# worden bij de volgende uitrol overschreven. Rechten 0600 (root).
#
# De database van het cluster. homepage-ctl.sh voorstart maakt daarmee
# /etc/cf-homepage/homepage.env: de instellingen van de oude node (na de
# overname), met daarover deze database.
POSTGRES_HOST={{ .params.db_vip }}
POSTGRES_PORT=5432
POSTGRES_USER=homepage
POSTGRES_PASSWORD={{ .params.db_password }}
POSTGRES_DB=homepage
