# Beheerd door ClusterForge (cluster {{ .cluster.slug }}). Wijzigingen hier
# worden bij de volgende uitrol overschreven.
#
# Zolang de database er nog niet is (die komt na de uitrol), stopt de Zabbix
# server meteen; systemd probeert het elke 15 seconden opnieuw.

[Unit]
Description=Zabbix server, HA-node {{ .node.hostname }} (ClusterForge)
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=zabbix
RuntimeDirectory=cf-zabbix-server
LoadCredential=db.conf:/etc/zabbix/cf-zabbix_server-db.conf
# Na een grote versie zet de VIP-node de database eerst om (standalone);
# dat kan lang duren. + draait het script als root.
ExecStartPre=+/usr/local/lib/clusterforge/zabbix-dbupgrade.sh
TimeoutStartSec=6h
ExecStart=/usr/sbin/zabbix_server -f -c /etc/zabbix/cf-zabbix_server.conf
Restart=always
RestartSec=15
TimeoutStopSec=60
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
