# Beheerd door ClusterForge (cluster {{ .cluster.slug }}). Wijzigingen hier
# worden bij de volgende uitrol overschreven. Rechten 0600 (root).
#
# De basis voor /etc/cf-cssthema/cssthema.env: cssthema-ctl.sh voorstart
# voegt er, na een overname, de instellingen van de oude node aan toe (die
# winnen, behalve de database en Redis).
POSTGRES_HOST={{ .params.db_vip }}
POSTGRES_PORT=5432
POSTGRES_USER=cssthema
POSTGRES_PASSWORD={{ .params.db_password }}
POSTGRES_DB=cssthema
REDIS_URL=redis://localhost:6379/0
{{- if .params.nieuw }}
ENVIRONMENT=production
SECRET_KEY={{ .params.secret_key }}
LOG_LEVEL=INFO
LOG_JSON=true
{{- if .params.dashboard_host }}
DASHBOARD_HOST={{ .params.dashboard_host }}
{{- end }}
{{- if .params.public_base_url }}
PUBLIC_BASE_URL={{ .params.public_base_url }}
{{- end }}
{{- if .params.trusted_proxies }}
TRUSTED_PROXIES={{ .params.trusted_proxies }}
{{- end }}
{{- end }}
