#!/bin/sh
# Beheerd door ClusterForge (cluster {{ .cluster.slug }}).
#
#   platform-ctl.sh up | down        het platform starten (alleen met het VIP) of
#                                    stoppen (cf-platform)
#   platform-ctl.sh check            mag deze node het VIP hebben? (keepalived)
#   platform-ctl.sh master|backup    keepalived: deze node kreeg of verloor het VIP
#   platform-ctl.sh unchanged        draait het hier met de huidige code en instellingen?
#   platform-ctl.sh restart-if-changed
#                                    opnieuw starten na een nieuwe versie of instelling,
#                                    met eerst een back-up van de database
#   platform-ctl.sh db-backup        back-up van de database (/var/backups/cf-platform)
#   platform-ctl.sh status [--stil]  de stand op deze node (ook voor ClusterForge)
#   platform-ctl.sh modellen [--check]
#                                    de modellen van gezichten en zoeken op beeld
#   platform-ctl.sh geo [--check]    de bronnen van de plaatsnamen (gedeelde data)
#   platform-ctl.sh replicatie [--check]
#                                    bestaande volumes (zonder collectie) naar de
#                                    replicatie van ClusterForge
#   platform-ctl.sh mapregels [--check]
#                                    de regels per map van SeaweedFS voor de kopieën
#                                    per bibliotheek (blobs-r1/ tot blobs-r3/)
#   platform-ctl.sh sleutels-klaar   mag de sync de sleutels van gezichten van hier
#                                    kopiëren en elders wissen? (voor de sync)
#   platform-ctl.sh compose …        docker compose met de bestanden van het cluster
#   platform-ctl.sh overstap proef|echt [datamap]
#                                    van de single-node op deze machine naar het cluster
#   platform-ctl.sh mount            weed mount starten (ExecStart van cf-platform-mount)
#   platform-ctl.sh geheugen         wat de mount aan geheugen gebruikt (RSS, anon, cache)
#   platform-ctl.sh backup-pauze [max-wachten-s] | backup-hervat
#                                    de mount los voor een back-up van deze CT (vzdump-hook
#                                    op de Proxmox-host) en daarna terug
#   platform-ctl.sh mappen           de mappen van het platform op de gedeelde data
#                                    (arr/ van uid 10001)
#   platform-ctl.sh verfris          weed mount (en het platform als het hier draait)
#                                    netjes herstarten; check doet het zelf als de
#                                    mount te veel geheugen gebruikt
#
# Mediabeheer (fase 11, ARR=aan en een versie met compose.arr.yaml): up start
# na de app ook qBittorrent en Prowlarr, down stopt ze; alleen op de node met
# het VIP.
#
# Het cluster staat los van een single-node op dezelfde machine: eigen code
# (/opt/cf-platform), image (cf-platform:local), project (cf-platform) en
# datamap (/srv/platform-data, SeaweedFS). Het platform start nergens zolang
# de markering op de gedeelde datamap ontbreekt; die zet de overstap.
#
# Nooit install.sh van het platform op een clusternode: dat maakt een tweede
# single met SQLite. Een nieuwe versie kies je in ClusterForge (Wijzigen,
# Versie).
set -u
SRC=/opt/cf-platform/src/infra/single
DATA=/srv/platform-data
ACTIVE=$DATA/.cf-platform-active
# Dezelfde markering op deze node zelf, niet op FUSE (fixlijst 26-11, punt 10):
# check (keepalived, om de 3 s), master en cf-platform.service lezen die
# lokale kopie. Een vastgelopen mount laat ze zo niet hangen. check zet hem
# zodra de gedeelde er is; bij het starten kijkt het nog eens naar de gedeelde.
ACTIVE_LOCAL=/var/lib/cf-platform/actief
# Back-up van deze CT (vzdump): de mount staat los zolang dit bestand er is
# (hoogstens 6 uur). Het slot op de gedeelde map laat één node tegelijk los.
PAUZE=/run/cf-platform-backup.pauze
PAUZE_SLOT=$DATA/.cf-backup-pauze
# Waakhond van de app (storing 27-11): check vraagt op de node met het VIP
# /health (hoogstens 4 s). Antwoordt de app GEZOND_WACHT s lang niet (en is de
# database wel bereikbaar), dan geeft deze node het VIP af. Pas nadat de app
# sinds zijn start één keer gezond was: een start met migraties telt niet.
GEZOND=/run/cf-platform-gezond
GEZOND_WACHT=60
# Geheugen van weed mount (anon en swap, niet de cache van de bestanden):
# boven VERFRIS_MB herstart check de mount en het platform netjes, hoogstens
# eens per 30 min. Ruim onder MemoryMax (2G) van cf-platform-mount.
VERFRIS=/run/cf-platform-verfris
VERFRIS_MB=1536
CGROUP=/sys/fs/cgroup
HASH=/run/cf-platform.hash
ENV=/etc/clusterforge/platform.env
VIP='{{ .params.vip }}'
CLUSTER='{{ .cluster.slug }}'
REF='{{ .params.platform_ref }}'
STATUS_DIR=/var/lib/clusterforge/app-status
BACKUPS=/var/backups/cf-platform
env_get() { sed -n "s/^$1=//p" "$ENV" | tail -n 1; }
MODELLEN=$(env_get MODELLEN_ROOT); MODELLEN=${MODELLEN:-/opt/cf-platform/modellen}
SLEUTELS=$(env_get SLEUTELS_ROOT); SLEUTELS=${SLEUTELS:-/var/lib/cf-platform/sleutels/gezichten}
BEELD_MAP=siglip2-b32-256
# Draait deze versie met de analyse (gezichten en zoeken op beeld)?
analyse_on() { [ "$(env_get ANALYSE)" = aan ] && [ -f "$SRC/compose.analyse.yaml" ]; }
# Mediabeheer (fase 11): qBittorrent en Prowlarr, met ARR=aan en een versie
# die compose.arr.yaml heeft. De downloads staan op deze node zelf.
ARR_TORRENTS=/var/lib/cf-platform/torrents
# arr_start mag starten zolang ARR_MAG er is (up zet het, down haalt het weg);
# het starten zelf en het stoppen in down wachten op elkaar via ARR_LOCK.
ARR_MAG=/run/cf-platform-arr.mag
ARR_LOCK=/run/cf-platform-arr.lock
arr_on() { [ "$(env_get ARR)" = aan ] && [ -f "$SRC/compose.arr.yaml" ]; }
# Lidarr (fixlijst 26-11, punt 8): mee met mediabeheer, als deze versie hem
# in compose.arr.yaml heeft.
lidarr_on() { arr_on && grep -q '^  lidarr:' "$SRC/compose.arr.yaml"; }
# De diensten van mediabeheer, die pas na arr-koppel starten.
arr_svcs() { if lidarr_on; then echo qbittorrent prowlarr lidarr; else echo qbittorrent prowlarr; fi; }
# De YouTube-module (fixlijst 26-11, punt 7): met YOUTUBE=aan en een versie
# die compose.youtube.yaml heeft. De helper start met de app mee.
youtube_on() { [ "$(env_get YOUTUBE)" = aan ] && [ -f "$SRC/compose.youtube.yaml" ]; }
# Kan Docker hier geheugen- en cpu-grenzen zetten? Zonder die cgroups (een
# LXC) start een container met grenzen niet; dan zonder (regel van install.sh).
limits_ok() {
  [ "$(docker info --format '{{"{{"}}.MemoryLimit{{"}}"}} {{"{{"}}.CPUCfsQuota{{"}}"}}' 2>/dev/null)" = "true true" ]
}
# Past een bestand met grenzen op deze node? Docker weigert een container met
# meer cpus dan de node heeft (media vraagt er 3); dan blijft dat bestand weg.
limits_fit() {
  ncpu=$(nproc 2>/dev/null) || return 1
  sed -n 's/^[[:space:]]*cpus:[[:space:]]*//p' "$1" | tr -d "\"'" |
    awk -v n="$ncpu" '($1 + 0) > (n + 0) { bad = 1 } END { exit bad }'
}
limits_use() { [ -n "$limits" ] && [ -f "$1" ] && limits_fit "$1"; }
compose() {
  if youtube_on; then
    set -- -f "$SRC/compose.youtube.yaml" -f /etc/clusterforge/platform-youtube.yaml "$@"
  fi
  if arr_on; then
    if lidarr_on; then set -- -f /etc/clusterforge/platform-lidarr.yaml "$@"; fi
    set -- -f "$SRC/compose.arr.yaml" -f /etc/clusterforge/platform-arr.yaml "$@"
  fi
  set -- -f /etc/clusterforge/platform-cluster.yaml "$@"
  limits=""; limits_ok && limits=1
  if analyse_on; then
    set -- -f /etc/clusterforge/platform-analyse.yaml "$@"
    if limits_use "$SRC/compose.analyse-limits.yaml"; then
      set -- -f "$SRC/compose.analyse-limits.yaml" "$@"
    fi
    set -- -f "$SRC/compose.analyse.yaml" "$@"
  fi
  # De grenzen van office en media (vanaf de versies die ze hebben).
  for lim in media office; do
    if limits_use "$SRC/compose.$lim-limits.yaml"; then
      set -- -f "$SRC/compose.$lim-limits.yaml" "$@"
    fi
  done
  docker compose -p cf-platform --project-directory "$SRC" --env-file "$ENV" \
    -f "$SRC/compose.yaml" -f "$SRC/compose.office.yaml" -f "$SRC/compose.media.yaml" "$@"
}
# Voor up: zeggen welke grenzen niet op deze node passen.
limits_note() {
  limits_ok || return 0
  set -- office media
  if analyse_on; then set -- "$@" analyse; fi
  for lim in "$@"; do
    lf=$SRC/compose.$lim-limits.yaml
    if [ -f "$lf" ] && ! limits_fit "$lf"; then
      echo "Let op: ${lf##*/} vraagt meer cpu's dan deze node heeft ($(nproc)); $lim start zonder grenzen." >&2
    fi
  done
}
fingerprint() {
  { cat "$ENV" /etc/clusterforge/platform-cluster.yaml
    if analyse_on; then
      cat /etc/clusterforge/platform-analyse.yaml
      find "$MODELLEN" -path "$MODELLEN/.*" -prune -o -type f -printf '%P %s\n' 2>/dev/null | sort
    fi
    if arr_on; then cat /etc/clusterforge/platform-arr.yaml; fi
    if lidarr_on; then cat /etc/clusterforge/platform-lidarr.yaml; fi
    if youtube_on; then cat /etc/clusterforge/platform-youtube.yaml; fi
    docker image inspect -f '{{"{{"}}.Id{{"}}"}}' cf-platform:local 2>/dev/null; } | sha256sum | cut -d' ' -f1
}
has_vip() { ip -o addr show | grep -q " $VIP/"; }
# Een commando op de FUSE-mount, hoogstens 5 s: zit de mount vast, dan
# blokkeert een stat of test daar voor altijd (en keepalived met hem).
fuse() { timeout -k 2 5 "$@"; }
gemount() { fuse mountpoint -q "$DATA"; }
# Is de overstap gedaan? De lokale markering, of de gedeelde (dan meteen ook
# lokaal).
overgestapt() {
  [ -f "$ACTIVE_LOCAL" ] && return 0
  fuse test -f "$ACTIVE" || return 1
  mkdir -p "${ACTIVE_LOCAL%/*}" &&
    { fuse cat "$ACTIVE" >"$ACTIVE_LOCAL.tmp" 2>/dev/null || :; } &&
    mv -f "$ACTIVE_LOCAL.tmp" "$ACTIVE_LOCAL"
  return 0
}
# Vlak voor het starten: staat de gedeelde markering er nog? Weg (terug naar
# de single): ook de lokale weg, en niet starten. Antwoordt de mount niet:
# ook niet starten.
start_ok() {
  fuse test -f "$ACTIVE"
  case $? in
    0) overgestapt ;;
    1) rm -f "$ACTIVE_LOCAL"; return 1 ;;
    *) return 1 ;;
  esac
}
# Een back-up van deze CT loopt (backup-pauze), hoogstens 6 uur oud.
gepauzeerd() { [ -n "$(find "$PAUZE" -mmin -360 2>/dev/null)" ]; }
# Startte weed mount opnieuw (een crash, de OOM-killer) terwijl het platform
# bleef draaien? Dan ziet de container in /data nog de oude, dode mount
# ("Transport endpoint is not connected") tot hij herstart.
mount_nieuwer() {
  m=$(systemctl show -p ExecMainStartTimestampMonotonic --value cf-platform-mount 2>/dev/null)
  p=$(systemctl show -p ActiveEnterTimestampMonotonic --value cf-platform 2>/dev/null)
  case "$m:$p" in *[!0-9:]* | :* | *:) return 1 ;; esac
  [ "$m" -gt 0 ] && [ "$p" -gt 0 ] && [ "$m" -gt "$p" ]
}
say() { echo "== $*"; }
fail() { echo "FOUT: $*" >&2; exit 1; }

# De database van de single (SQLite in de datamap) naar PostgreSQL, met de
# code van het cluster (app.cli db-copy). --leegmaken: wat er in PostgreSQL
# staat, gaat eerst weg.
db_copy() {
  url=$(sed -n 's/^PLATFORM_DATABASE_URL=//p' /etc/clusterforge/platform.env)
  docker run --rm --user 10001:10001 -v "$1:/data" -e PLATFORM_DATA_DIR=/data \
    cf-platform:local python -m app.cli db-copy "$url" --leegmaken
}

# De bestanden (blobs, media, office) naar SeaweedFS, zonder de SQLite.
# weed mount zet de tijd van een bestand bij het wegschrijven op "nu", ook als
# rsync er net de oorspronkelijke tijd op zette. De tweede ronde kopieert niets
# (--size-only) en zet alleen de tijden terug, zodat een volgende rsync enkel
# echte wijzigingen meeneemt.
sync_data() {
  set -- "$1/" "$DATA/" --exclude=/platform.db --exclude=/platform.db-wal \
    --exclude=/platform.db-shm --exclude=/backup/ --exclude=/.cf-platform-active
  rsync -aH --delete --info=stats1 "$@" && rsync -aH --size-only "$@"
}

overstap() {
  mode=${1:-}
  bron=${2:-/opt/platform/data/platform}
  case "$mode" in proef|echt) ;; *) fail "gebruik: $0 overstap proef|echt [datamap]" ;; esac
  say "Controles"
  [ -f "$ACTIVE" ] && fail "het cluster draait al (overstap gedaan op $(cat "$ACTIVE"))"
  gemount || fail "$DATA is niet gemount (journalctl -u cf-platform-mount)"
  [ -f "$bron/platform.db" ] || fail "geen $bron/platform.db: draait de single-node op deze machine?"
  docker image inspect cf-platform:local >/dev/null 2>&1 || fail "image cf-platform:local ontbreekt; rol het cluster eerst uit"
  command -v rsync >/dev/null || fail "rsync ontbreekt"
  echo "bron $bron ($(du -sh "$bron" | cut -f1)), doel $DATA"
  if [ "$mode" = proef ]; then
    say "Bestanden kopiëren (de single draait door)"
    sync_data "$bron" || fail "rsync"
    say "Database kopiëren naar PostgreSQL (proef)"
    db_copy "$bron" || fail "db-copy"
    say "Proef gelukt. Niets gestart; de single draait door. De echte overstap kopieert alleen nog wat erbij kwam."
    return 0
  fi
  single=$(docker ps -aq --filter label=com.docker.compose.project=platform)
  say "Bestanden kopiëren terwijl de single nog draait"
  sync_data "$bron" || fail "rsync"
  if [ -n "$single" ]; then
    say "Single stoppen (platform-platform-1 en co); start niet meer vanzelf"
    # shellcheck disable=SC2086
    docker update --restart=no $single >/dev/null && docker stop $single || fail "single stoppen"
  fi
  say "Laatste bestanden kopiëren"
  sync_data "$bron" || fail "rsync"
  say "Database kopiëren naar PostgreSQL"
  db_copy "$bron" || fail "db-copy (de single staat stil: start hem terug met: docker start $(echo $single))"
  date -Iseconds > "$ACTIVE"
  overgestapt
  say "Overgestapt. Het platform start op de node met het VIP ($VIP)."
  if has_vip; then systemctl start cf-platform && systemctl --no-pager status cf-platform | head -n 3; fi
  echo "Terug naar de single: rm $ACTIVE op een node, systemctl stop cf-platform op de VIP-node, docker start $(echo $single) (de kopie $ACTIVE_LOCAL op een node telt dan niet meer: die gaat weg zodra hij het platform wil starten)"
}


# --- back-up ---------------------------------------------------------------
# Een back-up van de database van het platform (pg_dump -Fc via het VIP van de
# database), vóór elke herstart met een nieuwe versie: de app voert bij de
# start zijn migraties zelf uit. De vijf nieuwste blijven staan.
#
# Zonder de rijen van de gezichten en de vectoren van beeld (de tabellen van
# app.cli backup-wipe-tables, vanaf 0.8.2): die horen nooit in een kopie.
# Kent de versie het commando niet, of draait het platform hier niet, dan de
# vaste lijst van het platform (api/app/backup.py, WIPE).
WIPE_TABLES="face_person face face_scan face_owner blob_embed"
wipe_tables() {
  list=""
  if systemctl is-active --quiet cf-platform; then
    list=$(compose exec -T platform python -m app.cli backup-wipe-tables </dev/null 2>/dev/null) || list=""
    list=$(printf '%s\n' "$list" | grep -Ex '[a-z_][a-z0-9_]{0,62}')
  fi
  [ -n "$list" ] || list=$(echo "$WIPE_TABLES" | tr ' ' '\n')
  printf '%s\n' "$list"
}
db_backup() {
  url=$(env_get PLATFORM_DATABASE_URL)
  rest=${url#*://}; cred=${rest%%@*}; hostdb=${rest#*@}
  user=${cred%%:*}; pass=${cred#*:}
  host=${hostdb%%/*}; db=${hostdb#*/}; port=${host##*:}; host=${host%:*}
  [ "$port" = "$host" ] && port=5432
  command -v pg_dump >/dev/null || fail "pg_dump ontbreekt"
  mkdir -p "$BACKUPS" && chmod 0700 "$BACKUPS"
  rev=$(cat /var/lib/clusterforge/platform-image.rev 2>/dev/null | cut -c1-12)
  out=$BACKUPS/platform-$(date +%Y%m%d-%H%M%S)-${rev:-onbekend}.dump
  tables=$(wipe_tables)
  set --
  for t in $tables; do set -- "$@" "--exclude-table-data=$t"; done
  say "Back-up van de database $db naar $out (zonder de rijen van $(printf '%s' "$tables" | tr '\n' ' '))"
  PGPASSWORD=$pass pg_dump -Fc -h "$host" -p "$port" -U "$user" -d "$db" "$@" -f "$out.deel" &&
    [ -s "$out.deel" ] && mv "$out.deel" "$out" || { rm -f "$out.deel"; fail "back-up mislukt"; }
  ls -lh "$out"
  # shellcheck disable=SC2012
  ls -1t "$BACKUPS"/platform-*.dump 2>/dev/null | tail -n +6 | while read -r f; do rm -f "$f"; done
}

# --- controle van een gedownload bestand ------------------------------------
# ok <pad> <bytes> <sha256>: een gewoon bestand (geen symlink) met precies die
# grootte en die sha256.
ok() {
  [ ! -L "$1" ] && [ -f "$1" ] && [ "$(stat -c %s -- "$1")" = "$2" ] &&
    [ "$(sha256sum -- "$1" | cut -d' ' -f1)" = "$3" ]
}
# ophalen <url> <bytes> <sha256> <doel>
ophalen() {
  curl -fsSL --retry 3 --connect-timeout 20 --max-time $((600 + $2 / 1000000)) --max-filesize "$2" -o "$4" "$1" </dev/null &&
    ok "$4" "$2" "$3"
}
name_ok() {
  case "/$1/" in
    // | *//* | */./* | */../*) return 1 ;;
    *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._/-]*) return 1 ;;
  esac
}
# De regels van models.lock: sha256 bytes naam url.
lock_lines() {
  grep -E '^[0-9a-f]{64}[[:space:]]+[1-9][0-9]{0,11}[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+' \
    "$SRC/../../api/app/analyse/models.lock" 2>/dev/null
}

# --- plaatsnamen ------------------------------------------------------------
# De bronnen van de plaatsnamen (DATA_ROOT/geo, zoals install.sh), één keer
# op de gedeelde bestanden; de app bouwt er bij de start places.sqlite van.
# De lijst komt uit install.sh van dezelfde versie (geo_bronnen). Het
# platform (uid 10001) zet ze zelf neer.
geo_list() {
  sed -n '/^geo_bronnen() {/,/^BRONNEN/p' "$SRC/install.sh" 2>/dev/null |
    grep -E '^[A-Za-z0-9._-]+ [0-9]+ [0-9a-f]{64} https://'
}
as_app() { setpriv --reuid=10001 --regid=10001 --clear-groups "$@"; }
geo() {
  [ "$(env_get PLAATSEN)" = uit ] && { echo "Plaatsnamen: uit"; return 0; }
  [ -f "$SRC/../../api/app/geo/load.py" ] || { echo "Plaatsnamen: deze versie heeft ze niet"; return 0; }
  list=$(geo_list)
  [ -n "$list" ] || { echo "Plaatsnamen: geen bronnen in install.sh"; return 0; }
  gemount || { echo "Plaatsnamen: $DATA is niet gemount" >&2; return 1; }
  [ -d "$DATA/geo" ] || as_app mkdir -m 0750 "$DATA/geo" || return 1
  missing=0
  echo "$list" | { while read -r name size sha url; do
      ok "$DATA/geo/$name" "$size" "$sha" && continue
      missing=1
      [ "${1:-}" = --check ] && continue
      tmp=$(mktemp)
      if ophalen "$url" "$size" "$sha" "$tmp" &&
        as_app sh -c 'umask 027 && cat >"$1.part" && mv -f "$1.part" "$1"' sh "$DATA/geo/$name" <"$tmp"; then
        echo "Plaatsnamen: $name opgehaald"
        missing=0
      else
        echo "Plaatsnamen: kon $name niet ophalen ($url)" >&2
        rm -f "$tmp"
        exit 1
      fi
      rm -f "$tmp"
    done
    [ "${1:-}" != --check ] || [ "$missing" = 0 ]; }
}

# --- modellen van de analyse ------------------------------------------------
# Zoals install.sh: de modellen van models.lock in MODELLEN_ROOT, op elke
# node zelf (de VIP kan overal komen). Zoeken op beeld (SigLIP 2, ±1,55 GB
# bron) zet de dienst analyse-omzetten van de versie zelf om, zonder netwerk.
beeld_ready() {
  lock_lines | while read -r sha size name url; do
    case $name in "$BEELD_MAP"/bron/*) continue ;; "$BEELD_MAP"/*) ;; *) continue ;; esac
    ok "$MODELLEN/$name" "$size" "$sha" || exit 1
  done
}
modellen_ready() {
  lock_lines | while read -r sha size name url; do
    case $name in "$BEELD_MAP"/*) continue ;; esac
    [ "$url" = - ] && continue
    ok "$MODELLEN/$name" "$size" "$sha" || exit 1
  done || return 1
  [ "$(env_get BEELD)" != aan ] || ! lock_lines | grep -q " $BEELD_MAP/" || beeld_ready
}
analyse_dirs() {
  mkdir -p "$MODELLEN" "$(dirname "$SLEUTELS")" && chown root:root "$MODELLEN" && chmod 0755 "$MODELLEN" || return 1
  [ -d "$SLEUTELS" ] || mkdir -m 0700 "$SLEUTELS" || return 1
  chown 10001:10001 "$SLEUTELS" && chmod 0700 "$SLEUTELS"
}
modellen() {
  if ! analyse_on; then
    echo "Analyse: uit of niet in deze versie"
    return 0
  fi
  if [ "${1:-}" = --check ]; then
    [ -d "$SLEUTELS" ] || return 1
    modellen_ready && return 0
    # Loopt zoeken op beeld nog op de achtergrond, dan is er niets te doen.
    systemctl is-active --quiet cf-platform-beeld
    return $?
  fi
  analyse_dirs || fail "de mappen van de analyse"
  docker image inspect cf-platform:local >/dev/null 2>&1 || fail "image cf-platform:local ontbreekt (platform-src.sh)"
  rm -rf "$MODELLEN"/.ophalen.* "$MODELLEN"/.beeld.*
  tmp=$(mktemp -d "$MODELLEN/.ophalen.XXXXXX") || fail "tijdelijke map"
  rc=0
  lock_lines | { while read -r sha size name url; do
      case $name in "$BEELD_MAP"/*) continue ;; esac
      [ "$url" = - ] && continue
      name_ok "$name" || { echo "Let op: ongeldige naam in models.lock: $name"; continue; }
      ok "$MODELLEN/$name" "$size" "$sha" && continue
      mkdir -p "$(dirname "$MODELLEN/$name")"
      if ophalen "$url" "$size" "$sha" "$tmp/model" && install -m 0644 -o root -g root "$tmp/model" "$tmp/klaar" &&
        mv -fT "$tmp/klaar" "$MODELLEN/$name"; then
        echo "Model geladen: $name"
      else
        echo "Kon $name niet ophalen ($url)" >&2
        rc=1
      fi
      rm -f "$tmp/model" "$tmp/klaar"
    done
    exit $rc; } || rc=1
  for f in "$SRC"/../../api/app/analyse/licenties/*.txt; do
    [ -f "$f" ] && install -m 0644 -o root -g root "$f" "$MODELLEN/${f##*/}"
  done
  rm -rf "$tmp"
  [ "$rc" = 0 ] && echo "Analyse: modellen van gezichten staan klaar in $MODELLEN"
  if [ "$(env_get BEELD)" = aan ] && lock_lines | grep -q " $BEELD_MAP/" && ! beeld_ready; then
    # ±1,6 GB ophalen en omzetten duurt langer dan een stap van de uitrol:
    # op de achtergrond, in een eigen unit (journalctl -u cf-platform-beeld).
    if systemctl is-active --quiet cf-platform-beeld; then
      echo "Zoeken op beeld: wordt al opgehaald (journalctl -u cf-platform-beeld)"
    else
      systemctl reset-failed cf-platform-beeld 2>/dev/null || true
      systemd-run --unit cf-platform-beeld --description "Model van zoeken op beeld" --no-block \
        /usr/local/lib/clusterforge/platform-ctl.sh beeld &&
        echo "Zoeken op beeld: het model wordt op de achtergrond opgehaald (journalctl -u cf-platform-beeld)"
    fi
  fi
  return $rc
}
beeld() {
  need=0
  for n in $(lock_lines | awk -v m="$BEELD_MAP/" 'index($3, m) == 1 { print $2 }'); do need=$((need + n * 2)); done
  avail=$(df --output=avail -B1 "$MODELLEN" | tail -n 1 | tr -d ' ')
  [ "$avail" -gt $((need + 100000000)) ] || { echo "Zoeken op beeld: te weinig ruimte in $MODELLEN ($((need / 1000000)) MB nodig)" >&2; return 1; }
  tmp=$(mktemp -d "$MODELLEN/.beeld.XXXXXX") || return 1
  mkdir -m 0755 "$tmp/bron" "$tmp/nieuw" && mkdir -m 0700 "$tmp/uit" && chown 10004:10003 "$tmp/uit" || { rm -rf "$tmp"; return 1; }
  if ! lock_lines | while read -r sha size name url; do
      case $name in "$BEELD_MAP"/bron/*) ;; *) continue ;; esac
      base=${name##*/}
      ophalen "$url" "$size" "$sha" "$tmp/bron/.deel" && chmod 0644 "$tmp/bron/.deel" && mv -fT "$tmp/bron/.deel" "$tmp/bron/$base" || {
        echo "Zoeken op beeld: kon $base niet ophalen" >&2; exit 1; }
      echo "Bron opgehaald: $name"
    done; then rm -rf "$tmp"; return 1; fi
  echo "Zoeken op beeld: het model omzetten (een paar minuten, zonder netwerk)…"
  if ! OMZET_BRON=$tmp/bron OMZET_UIT=$tmp/uit compose --profile omzetten run --rm --no-deps -T analyse-omzetten </dev/null; then
    echo "Zoeken op beeld: de omzetting lukte niet" >&2; rm -rf "$tmp"; return 1
  fi
  if ! lock_lines | while read -r sha size name url; do
      case $name in "$BEELD_MAP"/bron/*) continue ;; "$BEELD_MAP"/*) ;; *) continue ;; esac
      base=${name##*/}; f=$tmp/uit/$base
      [ ! -L "$f" ] && [ -f "$f" ] &&
        dd if="$f" of="$tmp/nieuw/$base" iflag=nofollow,nonblock,count_bytes count=$((size + 1)) bs=64K status=none 2>/dev/null &&
        chmod 0644 "$tmp/nieuw/$base" && ok "$tmp/nieuw/$base" "$size" "$sha" || {
        echo "Zoeken op beeld: $base klopt niet met models.lock" >&2; exit 1; }
    done; then rm -rf "$tmp"; return 1; fi
  [ ! -e "$MODELLEN/$BEELD_MAP" ] || mv -T "$MODELLEN/$BEELD_MAP" "$tmp/oud"
  mv -T "$tmp/nieuw" "$MODELLEN/$BEELD_MAP" || { [ -e "$tmp/oud" ] && mv -T "$tmp/oud" "$MODELLEN/$BEELD_MAP"; rm -rf "$tmp"; return 1; }
  rm -rf "$tmp"
  echo "Zoeken op beeld: het model staat klaar"
  # Draait het platform hier, dan leest de analyse het model bij een nieuwe start.
  if has_vip && systemctl is-active --quiet cf-platform; then
    compose up -d --no-deps --force-recreate analyse && fingerprint > "$HASH"
  fi
}

# --- sleutels van gezichten -------------------------------------------------
# De sync platform-sleutels van ClusterForge zet de sleutels elke minuut van
# de node met het VIP op de andere nodes, en wist daar wat hier niet (meer)
# staat. Eerst deze controle (before van de sync); faalt ze, dan kopieert en
# wist de sync niets. Alleen de node met het VIP, waar het platform draait,
# met een echte sleutelmap (geen symlink) van uid 10001, en pas als het
# platform zelf zegt dat elke sleutel die nodig is er staat en klopt
# (app.cli sleutels-check, vanaf 0.8.2). Zo wist een lege of halve map na een
# snelle failover nooit de sleutels elders. Een versie zonder sleutels-check
# faalt hier: dan gebeurt er niets.
#
# ClusterForge draait de sync op elke node met een VIP van het cluster, ook op
# de node met alleen het VIP van de database (de primary van PostgreSQL), en
# kort na een failover of tijdens een stop draait het platform er niet. Daar
# stuurt deze node niet: code 113 (SyncBeforeSkip van ClusterForge), niet 1.
# ClusterForge telt die run als overgeslagen: niets gekopieerd of gewist, en
# geen fout. 1 is een echte fout van de sleutels.
stuurt_niet() { echo "Niets gekopieerd of gewist: $*" >&2; exit 113; }
sleutels_klaar() {
  has_vip || stuurt_niet "deze node heeft het VIP van het platform ($VIP) niet; alleen die node stuurt de sleutels (verwacht op de node met het VIP van de database)"
  systemctl is-active --quiet cf-platform || stuurt_niet "het platform draait hier niet (cf-platform); de sleutels blijven zoals ze zijn (verwacht tijdens een start, stop of failover)"
  for d in "${SLEUTELS%/*}" "$SLEUTELS"; do
    [ ! -L "$d" ] && [ -d "$d" ] || fail "$d is geen gewone map; de sleutels blijven zoals ze zijn"
  done
  [ "$(stat -c %u -- "$SLEUTELS")" = 10001 ] || fail "$SLEUTELS is niet van uid 10001; de sleutels blijven zoals ze zijn"
  compose exec -T platform python -m app.cli sleutels-check </dev/null ||
    fail "sleutels-check van het platform is niet in orde (of deze versie kent het niet); niets gekopieerd of gewist"
}

# --- mappen op de gedeelde data ---------------------------------------------
# Mappen die het platform of zijn containers nodig hebben, van het platform
# (uid 10001). Maakt Docker een ontbrekende map voor een bind mount, dan is
# die van root, en dan kan qBittorrent of Prowlarr (PUID 10001) er niet in
# schrijven (fixlijst 26-11, punt 6). Ook een map die er al als root stond,
# krijgt 10001. Elke start op de VIP-node (up), en met de hand.
mappen() {
  gemount || { echo "$DATA is niet gemount, of de mount antwoordt niet" >&2; return 1; }
  set -- arr
  if arr_on; then set -- "$@" arr/qbittorrent arr/prowlarr; fi
  if lidarr_on; then set -- "$@" arr/lidarr import import/lidarr; fi
  if youtube_on; then set -- "$@" import import/youtube; fi
  for d in "$@"; do
    p=$DATA/$d
    fuse test -L "$p" && { echo "$p is een symlink; niets gewijzigd" >&2; return 1; }
    if ! fuse test -d "$p"; then
      fuse setpriv --reuid=10001 --regid=10001 --clear-groups mkdir -p "$p" ||
        { echo "kon $p niet maken" >&2; return 1; }
    fi
    if [ "$(fuse stat -c %u -- "$p")" != 10001 ]; then
      fuse chown -h 10001:10001 "$p" || { echo "kon de eigenaar van $p niet zetten" >&2; return 1; }
      echo "$p: eigenaar 10001"
    fi
  done
  return 0
}

# --- de mount (cf-platform-mount) -------------------------------------------
# Fixlijst 26-11, punt 5. weed mount buffert wat geschreven wordt tot het
# naar de volumes is: in het geheugen (hoogstens 4 x concurrentWriters
# stukken van 2 MB) en daarna in een wisselbestand op schijf
# (-cacheDirWrite). Zonder grens bleef dat groeien zolang de uploads achter
# liepen; -writeBufferSizeMB zet er een grens op (geheugen en wisselbestand
# samen) en laat een schrijver dan wachten. GOMEMLIMIT (de unit) laat Go
# opruimen voor de grens van systemd bereikt is. De drie opties van de
# hotfix staan er altijd; -writeBufferSizeMB alleen als deze weed hem kent.
MOUNT_CACHE=/var/cache/weed-mount
mount_start() {
  until curl -fsS -o /dev/null --max-time 10 http://127.0.0.1:8888/; do sleep 5; done
  # Een back-up van deze CT loopt: pas daarna mounten.
  while gepauzeerd; do sleep 10; done
  # Het wisselbestand van een vorige mount is waardeloos (wat er niet
  # weggeschreven was, is met die mount weg); weg ermee.
  rm -rf "$MOUNT_CACHE/write"
  mkdir -p "$MOUNT_CACHE/write"
  set -- -filer=127.0.0.1:8888 -filer.path=/ -dir="$DATA" -allowOthers \
    -cacheDir="$MOUNT_CACHE" -cacheDirWrite="$MOUNT_CACHE/write" \
    -concurrentWriters=8 -cacheCapacityMB=512
  hulp=$(/usr/local/bin/weed help mount 2>&1)
  case "$hulp" in *-writeBufferSizeMB*) set -- "$@" -writeBufferSizeMB=1024 ;; esac
  # De buffers van het lezen in het geheugen (standaard 256 MB, 4.47+).
  case "$hulp" in *-readerCacheSizeMB*) set -- "$@" -readerCacheSizeMB=128 ;; esac
  # Staat de grens van de unit (MemoryMax, MemorySwapMax) echt op deze
  # cgroup? In een CT zonder memory-controller doet systemd het stil niet.
  cg=$CGROUP$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null)
  max=$(cat "$cg/memory.max" 2>/dev/null); swap=$(cat "$cg/memory.swap.max" 2>/dev/null)
  echo "weed mount: geheugengrens ${max:-onbekend}, swap ${swap:-onbekend} ($cg)"
  case "$max" in '' | max) echo "LET OP: geen geheugengrens op weed mount (MemoryMax werkt niet in deze CT); de waakhond van check (verfris) vangt het op" >&2 ;; esac
  exec /usr/local/bin/weed mount "$@"
}
mount_pid() {
  pid=$(systemctl show -p MainPID --value cf-platform-mount 2>/dev/null)
  case "$pid" in '' | 0 | *[!0-9]*) return 1 ;; esac
  echo "$pid"
}
# RSS van weed mount in bytes (leeg als hij niet draait).
mount_rss() {
  pid=$(mount_pid) || return 0
  awk '/^VmRSS:/ { print $2 * 1024 }' "/proc/$pid/status" 2>/dev/null
}
# De cgroup van cf-platform-mount (leeg als systemd hem niet kent).
mount_cg() {
  c=$(systemctl show -p ControlGroup --value cf-platform-mount 2>/dev/null)
  [ -n "$c" ] && [ -r "$CGROUP$c/memory.stat" ] && echo "$CGROUP$c"
}
# Het eigen geheugen van weed mount in bytes: anon (in het RAM) plus wat er
# in swap staat; niet de cache van de bestanden, die geeft de kernel zelf
# terug. Zonder cgroup: de RSS en VmSwap van het proces.
mount_anon() {
  if cg=$(mount_cg); then
    a=$(awk '$1 == "anon" { print $2 }' "$cg/memory.stat")
    sw=$(cat "$cg/memory.swap.current" 2>/dev/null)
    echo $((${a:-0} + ${sw:-0}))
  elif pid=$(mount_pid); then
    awk '/^VmRSS:|^VmSwap:/ { s += $2 } END { print s * 1024 }' "/proc/$pid/status" 2>/dev/null
  fi
}
# Gebruikt de mount te veel (boven VERFRIS_MB) en was er de laatste 30 min
# geen verfris: dan nu (op de achtergrond, check wacht er niet op).
verfris_nodig() {
  m=$(mount_anon)
  [ -n "$m" ] && [ "$m" -gt $((VERFRIS_MB * 1024 * 1024)) ] || return 1
  [ -n "$(find "$VERFRIS" -mmin -30 2>/dev/null)" ] && return 1
  echo "weed mount gebruikt $(human "$m") (grens voor verfris ${VERFRIS_MB} MiB): mount en platform herstarten" >&2
  : >"$VERFRIS"
  systemd-run --no-block --unit=cf-platform-verfris --collect "$0" verfris >/dev/null 2>&1 || "$0" verfris &
  return 0
}
# verfris: het platform hier stoppen (als het draait), weed mount herstarten
# (en zo zijn geheugen terug), wachten tot hij weer antwoordt en het platform
# weer starten. check (keepalived) laat het VIP zolang hier.
verfris() {
  : >"$VERFRIS"
  draaide=0
  systemctl is-active --quiet cf-platform && draaide=1
  [ "$draaide" = 1 ] && systemctl stop cf-platform
  systemctl restart cf-platform-mount
  i=0
  until gemount; do
    i=$((i + 1))
    [ "$i" -ge 90 ] && { echo "verfris: de mount kwam niet terug na 3 min: journalctl -u cf-platform-mount" >&2; return 1; }
    sleep 2
  done
  if [ "$draaide" = 1 ] && has_vip && start_ok; then systemctl start --no-block cf-platform; fi
  echo "verfris: weed mount herstart"
}
# Antwoordt de database (het VIP van PostgreSQL) niet? Dan helpt het VIP
# verhuizen niet: het platform hangt elders net zo. Zonder pg_isready: onbekend.
db_weg() {
  command -v pg_isready >/dev/null 2>&1 || return 1
  url=$(env_get PLATFORM_DATABASE_URL)
  hostdb=${url#*://}; hostdb=${hostdb#*@}; host=${hostdb%%/*}
  port=${host##*:}; host=${host%:*}
  [ "$port" = "$host" ] && port=5432
  timeout 5 pg_isready -q -h "$host" -p "$port" -t 3 >/dev/null 2>&1
  rc=$?
  [ "$rc" -eq 2 ] || [ "$rc" -eq 124 ]
}
# gezond: 1 als de app hier al GEZOND_WACHT s niet antwoordt (zie GEZOND).
# Het bestand: <start van cf-platform> ok, of <start> fout <sinds epoch>.
gezond() {
  start=$(systemctl show -p ActiveEnterTimestampMonotonic --value cf-platform 2>/dev/null)
  if curl -fsS -o /dev/null --max-time 4 http://127.0.0.1:80/health 2>/dev/null; then
    echo "$start ok" >"$GEZOND"
    return 0
  fi
  [ -f "$GEZOND" ] || return 0
  read -r s st sinds <"$GEZOND" || return 0
  # Sinds deze start nog nooit gezond: het platform start nog.
  [ "$s" = "$start" ] || return 0
  nu=$(date +%s)
  if [ "$st" = ok ] || db_weg; then
    # Eerste fout, of de database zelf is weg: de klok (opnieuw) starten.
    echo "$start fout $nu" >"$GEZOND"
    return 0
  fi
  case "$sinds" in '' | *[!0-9]*) echo "$start fout $nu" >"$GEZOND"; return 0 ;; esac
  [ $((nu - sinds)) -ge "$GEZOND_WACHT" ] || return 0
  echo "De app antwoordt al $((nu - sinds)) s niet op /health (de database wel): VIP afgeven" >&2
  return 1
}
# Wat de mount aan geheugen gebruikt. RSS is het proces zelf (vooral de
# heap van Go); de cgroup van de unit telt ook de cache van de bestanden
# die hij schrijft en leest (file), en die geeft de kernel terug als het
# krap wordt (MemoryHigh). Groeit anon over uren door, ook na een import,
# dan lekt weed mount zelf; groeit vooral file, dan is het cache.
geheugen() {
  pid=$(mount_pid) || { echo "weed mount draait niet"; return 1; }
  echo "weed mount (pid $pid): RSS $(human "$(mount_rss)")"
  if cg=$(mount_cg); then
    echo "cgroup van cf-platform-mount: $(human "$(cat "$cg/memory.current")") (grens $(cat "$cg/memory.max" 2>/dev/null), swap $(human "$(cat "$cg/memory.swap.current" 2>/dev/null)") van $(cat "$cg/memory.swap.max" 2>/dev/null))"
    echo "  eigen geheugen (anon + swap): $(human "$(mount_anon)"); verfris boven ${VERFRIS_MB} MiB"
    awk '$1 == "anon" || $1 == "file" || $1 == "file_dirty" || $1 == "file_writeback" || $1 == "shmem" { printf "  %-15s %s\n", $1, $2 }' "$cg/memory.stat" |
      while read -r k v; do printf '  %-15s %s\n' "$k" "$(human "$v")"; done
    [ -r "$cg/memory.events" ] && echo "  oom_kill: $(awk '$1 == "oom_kill" { print $2 }' "$cg/memory.events")"
  fi
  du -sh "$MOUNT_CACHE/write" "$MOUNT_CACHE" 2>/dev/null | sed 's/^/  schijf: /'
  [ -f "$VERFRIS" ] && echo "  laatste verfris: $(date -r "$VERFRIS" '+%F %T')"
  return 0
}

# --- back-up van deze CT (vzdump) -------------------------------------------
# Fixlijst 26-11, punt 3. vzdump bevriest de CT voor een snapshot (en in
# suspend-modus kopieert het met rsync). Een FUSE-mount in de CT laat dat
# vastlopen: de daemon van de mount bevriest mee, en wat op de mount wacht,
# bevriest nooit; de host zelf mag er niet in (Permission denied op
# /srv/platform-data). Daarom zet de vzdump-hook op de Proxmox-host
# (deploy/proxmox/vzdump-media-platform.sh) de mount los vóór de snapshot
# en daarna weer vast. De bestanden staan op SeaweedFS op elke node; die
# horen niet in de back-up van de CT.
#
# backup-pauze: één node tegelijk (het slot op de gedeelde map, hoogstens
# max-wachten seconden wachten, standaard 2 uur), dan geeft deze node het VIP
# af (check faalt), het platform stopt en de mount gaat los. Na 6 uur
# komt de mount vanzelf terug, ook als backup-hervat nooit komt.
pauze_van() { fuse cat "$PAUZE_SLOT/van" 2>/dev/null; }
backup_pauze() {
  wacht=${1:-7200}
  case "$wacht" in '' | *[!0-9]*) fail "gebruik: $0 backup-pauze [max-wachten-s]" ;; esac
  me=$(hostname)
  if gemount; then
    t=0
    while :; do
      if fuse mkdir "$PAUZE_SLOT" 2>/dev/null; then
        printf '%s %s\n' "$me" "$(date +%s)" | fuse tee "$PAUZE_SLOT/van" >/dev/null
        break
      fi
      # shellcheck disable=SC2046
      set -- $(pauze_van)
      # Van deze node zelf (een vorige keer niet opgeruimd) of ouder dan 6 uur: overnemen.
      if [ "${1:-}" = "$me" ] || { [ -n "${2:-}" ] && [ $(($(date +%s) - $2)) -gt 21600 ]; }; then
        printf '%s %s\n' "$me" "$(date +%s)" | fuse tee "$PAUZE_SLOT/van" >/dev/null
        break
      fi
      [ "$t" -ge "$wacht" ] && fail "de mount van ${1:-een andere node} staat al los voor een back-up; na $wacht s nog altijd. Geen back-up van deze CT nu (de mount blijft vast)."
      [ "$t" = 0 ] && echo "Wacht: de mount van ${1:-een andere node} staat los voor een back-up."
      sleep 30; t=$((t + 30))
    done
  fi
  : >"$PAUZE"
  # Komt backup-hervat nooit (de hook liep vast), dan na 6 uur toch.
  systemctl stop cf-platform-backup-hervat.timer >/dev/null 2>&1 || :
  systemd-run --unit=cf-platform-backup-hervat --on-active=6h --timer-property=AccuracySec=1min \
    /usr/local/lib/clusterforge/platform-ctl.sh backup-hervat >/dev/null 2>&1 ||
    echo "Let op: geen timer voor het terugzetten; zet de mount na de back-up terug met platform-ctl.sh backup-hervat" >&2
  # check faalt nu: keepalived geeft het VIP aan een andere node (fall x interval).
  t=0
  while has_vip && [ "$t" -lt 120 ]; do sleep 2; t=$((t + 2)); done
  has_vip && echo "Let op: deze node heeft het VIP nog (geen andere node neemt het); het platform stopt tot na de back-up" >&2
  systemctl stop cf-platform || :
  systemctl stop cf-platform-mount || { backup_hervat; fail "cf-platform-mount stopt niet"; }
  if mountpoint -q "$DATA" 2>/dev/null; then
    backup_hervat; fail "$DATA is nog gemount; geen back-up nu"
  fi
  echo "De mount staat los voor de back-up van $me."
}
backup_hervat() {
  rm -f "$PAUZE"
  systemctl stop cf-platform-backup-hervat.timer >/dev/null 2>&1 || :
  systemctl start --no-block cf-platform-mount
  t=0
  while ! gemount && [ "$t" -lt 180 ]; do sleep 3; t=$((t + 3)); done
  gemount || { echo "Let op: de mount is na 3 minuten nog niet terug (journalctl -u cf-platform-mount)" >&2; return 1; }
  # shellcheck disable=SC2046
  set -- $(pauze_van)
  [ "${1:-}" = "$(hostname)" ] && fuse rm -rf "$PAUZE_SLOT"
  echo "De mount is terug."
}

# --- mediabeheer (fase 11) --------------------------------------------------
# qBittorrent en Prowlarr draaien alleen op de node met het VIP, net als de
# app, en nooit door Docker zelf herstart (platform-arr.yaml). Hun config
# staat in DATA_ROOT/arr, op SeaweedFS; de downloads in $ARR_TORRENTS op
# deze node: torrents schrijven veel kleine stukken door elkaar, en dat is
# op de FUSE-mount traag. De app ziet die map als /data/import/torrents. Na
# een failover mist qBittorrent op de nieuwe node de bestanden van een
# lopende download (fout); de app haalt die dan weg en zoekt de titel
# opnieuw. Wat al geïmporteerd is, staat op SeaweedFS.
arr_dirs() {
  [ -L "$ARR_TORRENTS" ] && fail "$ARR_TORRENTS is een symlink"
  mkdir -p "$ARR_TORRENTS" && chown 10001:10001 "$ARR_TORRENTS" && chmod 0750 "$ARR_TORRENTS" || return 1
  # Het mountpunt in de importmap, van het platform (uid 10001), niet van root.
  [ -d "$DATA/import/torrents" ] || as_app mkdir -p "$DATA/import/torrents"
}
# Zodra de app antwoordt: arr-koppel zet de gebruiker van qBittorrent en de
# sleutel van Prowlarr in hun config en in de app (vóór hun eerste start),
# dan pas de twee containers. Op de achtergrond van up; elke stap kijkt of
# het nog mag (arr_mag): up loopt nog, down is niet begonnen ($ARR_MAG) en
# deze node heeft het VIP. Het starten houdt $ARR_LOCK vast; down wacht daarop
# en stopt daarna wat er toch nog startte. Elke afloop meldt één regel
# "Mediabeheer: …".
arr_mag() { [ -f "$ARR_MAG" ] && kill -0 "$$" 2>/dev/null && has_vip; }
ARR_STOPT="Mediabeheer: het platform stopt hier of deze node heeft het VIP niet meer"
arr_start() {
  i=0
  until curl -fsS -o /dev/null --max-time 5 http://127.0.0.1:80/health; do
    i=$((i + 1))
    arr_mag || { echo "$ARR_STOPT; qBittorrent en Prowlarr starten niet" >&2; return 1; }
    if [ "$i" -gt 180 ]; then
      echo "Mediabeheer: de app antwoordt niet; qBittorrent en Prowlarr starten niet" >&2
      return 1
    fi
    sleep 5
  done
  arr_mag || { echo "$ARR_STOPT; qBittorrent en Prowlarr starten niet" >&2; return 1; }
  compose exec -T platform python -m app.cli arr-koppel </dev/null ||
    { echo "Mediabeheer: koppelen lukte niet (app.cli arr-koppel); qBittorrent en Prowlarr starten niet" >&2; return 1; }
  (
    flock 9 || { echo "Mediabeheer: geen slot op $ARR_LOCK; qBittorrent en Prowlarr starten niet" >&2; exit 1; }
    arr_mag || { echo "$ARR_STOPT; qBittorrent en Prowlarr starten niet" >&2; exit 1; }
    # shellcheck disable=SC2046
    compose up -d --no-deps $(arr_svcs) </dev/null ||
      { echo "Mediabeheer: qBittorrent of Prowlarr kon niet starten" >&2; exit 1; }
    # Begon down of verdween het VIP terwijl ze startten: meteen weer weg.
    arr_mag || { arr_stop; echo "$ARR_STOPT; qBittorrent en Prowlarr weer gestopt" >&2; exit 1; }
    echo "Mediabeheer: qBittorrent en Prowlarr draaien (Prowlarr op http://$VIP:9696)"
  ) 9>"$ARR_LOCK"
}
# qBittorrent en Prowlarr van dit cluster stoppen, ook als ARR intussen uit staat.
arr_stop() {
  for svc in qbittorrent prowlarr lidarr; do
    ids=$(docker ps -q --filter label=com.docker.compose.project=cf-platform --filter "label=com.docker.compose.service=$svc")
    # shellcheck disable=SC2086
    [ -z "$ids" ] || docker stop $ids >/dev/null
  done
}

# --- replicatie van SeaweedFS -----------------------------------------------
# Verandert de replicatie in ClusterForge (Wijzigen, Replicatie), dan zet de
# leider van de masters de bestaande volumes om en maakt hij de ontbrekende
# kopieën (volume.fix.replication). Nieuwe volumes krijgen de nieuwe waarde
# al van de master. --check: staan alle volumes al op de gewenste waarde, of
# is deze node niet de leider?
#
# Alleen de volumes zonder collectie (de standaardcollectie, blobs/). Een
# collectie heeft haar eigen regel: de kopieën per bibliotheek (platform
# 0.8.3) staan in de collecties r1, r2 en r3 op 1, 2 en 3 kopieën (mapregels
# hieronder), en een oude collectie media van fase 11 (blobs-media/) houdt
# de hare; die blijven zoals ze zijn. Daarom per volume (-volumeId), niet met
# -collectionPattern: wat een leeg patroon betekent, verschilt per versie van
# SeaweedFS.
REPLICATIE='{{ .params.replication }}'
weed_leader() {
  curl -fsS --max-time 5 http://127.0.0.1:9333/cluster/status 2>/dev/null | grep -q '"IsLeader": *true'
}
volumes_default() {
  # Elk volume zonder collectie als "id xyz" (xyz: zijn ReplicaPlacement), uit
  # de volume server van elke node. Een volume is een object in een lijst; de
  # objecten erin (ReplicaPlacement, Ttl) hebben geen lijsten, dus elk volume
  # komt op een eigen regel, wat de volgorde van de velden ook is.
  curl -fsS --max-time 20 http://127.0.0.1:9333/vol/status 2>/dev/null | tr -d '\n' |
    sed 's/}[[:space:]]*,[[:space:]]*{/}\n{/g; s/\[[[:space:]]*{/[\n{/g' |
    awk '/^[{]/ && /"Collection": *""/ && match($0, /"Id": *[0-9]+/) {
      id = substr($0, RSTART, RLENGTH); sub(/.*: */, "", id)
      if (!match($0, /"ReplicaPlacement": *[{][^}]*[}]/)) next
      rp = substr($0, RSTART, RLENGTH); n = r = d = 0
      if (match(rp, /"(node|SameRackCount)": *[0-9]+/)) { v = substr(rp, RSTART, RLENGTH); sub(/.*: */, "", v); n = v }
      if (match(rp, /"(rack|DiffRackCount)": *[0-9]+/)) { v = substr(rp, RSTART, RLENGTH); sub(/.*: */, "", v); r = v }
      if (match(rp, /"(dc|DiffDataCenterCount)": *[0-9]+/)) { v = substr(rp, RSTART, RLENGTH); sub(/.*: */, "", v); d = v }
      print id, d r n }'
}
# De ids van de volumes zonder collectie die niet op $REPLICATIE staan.
volumes_other() { volumes_default | awk -v want="$REPLICATIE" '$2 != want { print $1 }' | sort -un; }
replicatie() {
  weed_leader || { [ "${1:-}" = --check ] && return 0; echo "Niet de leider van de masters; die zet de replicatie om."; return 0; }
  other=$(volumes_other | wc -l)
  if [ "${1:-}" = --check ]; then
    [ "$other" = 0 ] || systemctl is-active --quiet cf-platform-replicatie
    return $?
  fi
  if [ "$other" = 0 ]; then echo "Alle volumes staan al op $REPLICATIE"; return 0; fi
  if [ "${1:-}" != --nu ]; then
    # Kopieën maken kan uren duren: op de achtergrond, in een eigen unit.
    systemctl is-active --quiet cf-platform-replicatie && { echo "Replicatie: loopt al (journalctl -u cf-platform-replicatie)"; return 0; }
    systemctl reset-failed cf-platform-replicatie 2>/dev/null || true
    systemd-run --unit cf-platform-replicatie --description "SeaweedFS-volumes naar replicatie $REPLICATIE" --no-block \
      /usr/local/lib/clusterforge/platform-ctl.sh replicatie --nu
    echo "Replicatie: $other volumes naar $REPLICATIE, op de achtergrond (journalctl -u cf-platform-replicatie)"
    return 0
  fi
  say "$other volumes naar replicatie $REPLICATIE, dan de ontbrekende kopieën maken"
  { echo lock
    for id in $(volumes_other); do echo "volume.configure.replication -volumeId $id -replication $REPLICATIE"; done
    echo volume.fix.replication
    echo unlock; } | /usr/local/bin/weed shell -master=127.0.0.1:9333
  left=$(volumes_other | wc -l)
  echo "Nog $left volumes niet op $REPLICATIE"
}

# --- regels per map van SeaweedFS (kopieën per bibliotheek) -----------------
# Platform 0.8.3 zet met PLATFORM_BLOB_SPLIT=true inhoud met een ander aantal
# kopieën dan de standaard in blobs-r1/, blobs-r2/ en blobs-r3/ (naast
# blobs/). Een regel per map in de filer (fs.configure, geldt voor het hele
# cluster) geeft elke map een eigen collectie en replicatie; de mount
# gebruikt -filer.path=/, dus $DATA/blobs-r2 is /blobs-r2/ in de filer.
# mapregels schrijft een regel alleen als hij ontbreekt of een andere
# collectie of replicatie heeft, en leest daarna na wat er staat. Zonder het
# slot van weed shell: fs.configure vraagt er niet om, en lock wacht op wie
# het heeft (replicatie --nu kan uren duren). weed shell toch altijd met een
# timeout. Met PLATFORM_BLOB_SPLIT uit doet het niets en haalt het niets weg;
# een regel voor /blobs-media/ (fase 11) laat het altijd zoals hij is.
# --check: staan ze er alle drie goed (of staat het uit)?
MAPREGELS='/blobs-r1/ r1 000
/blobs-r2/ r2 001
/blobs-r3/ r3 002'
split_on() { [ "$(env_get PLATFORM_BLOB_SPLIT)" = true ]; }
weed_shell() { timeout "$1" /usr/local/bin/weed shell -master=127.0.0.1:9333; }
# De regels van de filer als "map collectie replicatie" (- voor leeg), uit de
# JSON van fs.configure zonder -locationPrefix (alleen lezen, zonder slot).
# De velden heten locationPrefix, collection en replication; het aantal
# spaties na de dubbele punt wisselt (protojson). Faalt als weed shell faalt
# of geen configuratie gaf. mapregels_lees <timeout>
mapregels_lees() {
  out=$(printf 'fs.configure\n' | weed_shell "$1" 2>/dev/null) || return 1
  case $out in *'"locations"'*) ;; *) return 1 ;; esac
  printf '%s\n' "$out" | tr -d '\n' | sed 's/{/\n{/g' |
    awk 'function f(k,  v) {
        if (!match($0, "\"" k "\":[ \t]*\"[^\"]*\"")) return "-"
        v = substr($0, RSTART, RLENGTH); sub(/^[^:]*:[ \t]*"/, "", v); sub(/"$/, "", v)
        return v == "" ? "-" : v }
      /"locationPrefix"/ { print f("locationPrefix"), f("collection"), f("replication") }'
}
# De regels van MAPREGELS die ontbreken of anders zijn. mapregels_mis <timeout>
mapregels_mis() {
  have=$(mapregels_lees "$1") || return 1
  printf '%s\n' "$MAPREGELS" | while read -r p c r; do
    printf '%s\n' "$have" | grep -qxF "$p $c $r" || echo "$p $c $r"
  done
}
mapregels() {
  if ! split_on; then
    [ "${1:-}" = --check ] || echo "Regels per map: kopieën per bibliotheek staan uit (PLATFORM_BLOB_SPLIT); niets gezet of weggehaald"
    return 0
  fi
  mis=$(mapregels_mis 30) || {
    echo "Let op: kon de regels per map van SeaweedFS niet lezen (weed shell, fs.configure)" >&2; return 1; }
  if [ -z "$mis" ]; then
    [ "${1:-}" = --check ] || echo "Regels per map: /blobs-r1/, /blobs-r2/ en /blobs-r3/ staan goed"
    return 0
  fi
  [ "${1:-}" = --check ] && return 1
  say "Regels per map zetten: $(printf '%s\n' "$mis" | awk '{ printf "%s%s (collectie %s, replicatie %s)", (NR > 1 ? ", " : ""), $1, $2, $3 }')"
  printf '%s\n' "$mis" | while read -r p c r; do
    echo "fs.configure -locationPrefix=$p -collection=$c -replication=$r -apply"
  done | weed_shell 90 >/dev/null
  # Nakijken wat er nu staat: weed shell geeft niet bij elke fout een code.
  mis=$(mapregels_mis 30) || {
    echo "Let op: kon de regels per map van SeaweedFS na het zetten niet lezen" >&2; return 1; }
  if [ -n "$mis" ]; then
    echo "Let op: de regels per map van SeaweedFS staan nog niet goed: $(printf '%s\n' "$mis" | awk '{ printf "%s%s", (NR > 1 ? ", " : ""), $1 }')" >&2
    return 1
  fi
  echo "Regels per map: /blobs-r1/, /blobs-r2/ en /blobs-r3/ staan goed"
}

# --- stand voor ClusterForge ------------------------------------------------
# platform-ctl.sh status schrijft $STATUS_DIR/media-platform.json; de agent
# stuurt dat mee met de facts (protocol 48). De controles van het platform
# zelf (app, containers, http, plaatsnamen, analyse) doet alleen de node met
# het VIP; elke node meldt zijn eigen mount, SeaweedFS, modellen en schijf.
jesc() { printf '%s' "$1" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g'; }
CHECKS=""; VALUES=""; BAD=0
chk() { # chk <id> <label> <ok 0|1> <red|amber> <detail>
  CHECKS="$CHECKS${CHECKS:+,}{\"id\":\"$1\",\"label\":\"$(jesc "$2")\",\"ok\":$([ "$3" = 1 ] && echo true || echo false),\"severity\":\"$4\",\"detail\":\"$(jesc "$5")\"}"
  [ "$3" = 1 ] || BAD=$((BAD + 1))
  [ -n "$STIL" ] || printf '%-6s %-34s %s\n' "$([ "$3" = 1 ] && echo ok || echo FOUT)" "$2" "$5"
}
val() { # val <id> <label> <tekst> [bytes]
  VALUES="$VALUES${VALUES:+,}{\"id\":\"$1\",\"label\":\"$(jesc "$2")\",\"value\":\"$(jesc "$3")\"${4:+,\"bytes\":$4}}"
  [ -n "$STIL" ] || printf '       %-34s %s\n' "$2" "$3"
}
human() { numfmt --to=iec --suffix=B "${1:-0}" 2>/dev/null || echo "$1 B"; }
status() {
  STIL=""; [ "${1:-}" = --stil ] && STIL=1
  rev=$(cat /var/lib/clusterforge/platform-image.rev 2>/dev/null)
  role=stand-by; has_vip && role=actief
  overgestapt || role=voor-overstap
  [ -n "$STIL" ] || echo "== $(hostname) ($role), versie $REF ${rev:+(${rev%"${rev#????????????}"})}"
  # Elke node
  mnt=0; gemount && mnt=1
  chk mount "Bestanden gemount ($DATA)" "$mnt" red "$([ "$mnt" = 1 ] && echo gemount || { gepauzeerd && echo "los voor een back-up van deze CT"; } || echo "niet gemount of antwoordt niet: journalctl -u cf-platform-mount")"
  mg=$(mount_rss)
  [ -n "$mg" ] && val mount_rss "Geheugen van de mount (RSS)" "$(human "$mg")" "$mg"
  if cg=$(mount_cg); then
    gm=$(cat "$cg/memory.max" 2>/dev/null)
    chk mount_grens "Geheugengrens op de mount" "$([ "$gm" != max ] && echo 1 || echo 0)" amber \
      "$([ "$gm" != max ] && echo "$(human "$gm"), eigen $(human "$(mount_anon)")" || echo "geen: MemoryMax werkt niet in deze CT (alleen de verfris van check)")"
  fi
  sw=0; systemctl is-active --quiet cf-seaweedfs && sw=1
  chk seaweedfs "SeaweedFS (master, volume, filer)" "$sw" red "$(systemctl is-active cf-seaweedfs 2>/dev/null)"
  vb=$(du -sb /srv/seaweedfs/volume 2>/dev/null | cut -f1)
  val volume_bytes "Media op deze node (SeaweedFS-volumes)" "$(human "$vb")" "${vb:-0}"
  # shellcheck disable=SC2046
  set -- $(df --output=size,avail -B1 /srv/seaweedfs/volume 2>/dev/null | tail -n 1)
  size=${1:-0}; avail=${2:-0}
  val disk_free "Vrij op de schijf van de volumes" "$(human "$avail") van $(human "$size")" "$avail"
  free_ok=1; sev=amber
  if [ "$size" -gt 0 ]; then
    [ $((avail * 100 / size)) -lt 10 ] && free_ok=0
    [ $((avail * 100 / size)) -lt 5 ] && sev=red
  fi
  chk disk "Ruimte voor de volumes" "$free_ok" "$sev" "$(human "$avail") vrij"
  if analyse_on; then
    m=0; modellen_ready && m=1
    chk modellen "Modellen van gezichten en zoeken op beeld" "$m" amber "$([ "$m" = 1 ] && echo klaar || echo "ontbreken: platform-ctl.sh modellen")"
    mb=$(du -sb "$MODELLEN" 2>/dev/null | cut -f1)
    val modellen_bytes "Modellen" "$(human "$mb")" "${mb:-0}"
  fi
  last=$(ls -1t "$BACKUPS"/platform-*.dump 2>/dev/null | head -n 1)
  [ -n "$last" ] && val backup "Laatste back-up van de database" "$(basename "$last") ($(human "$(stat -c %s "$last")"))"
  # Alleen de node met het VIP: het platform zelf.
  if [ "$role" = actief ]; then
    app=0; systemctl is-active --quiet cf-platform && app=1
    chk platform "Platform draait (cf-platform)" "$app" red "$(systemctl is-active cf-platform 2>/dev/null)"
    if [ "$app" = 1 ]; then
      bad=$(docker ps -a --filter label=com.docker.compose.project=cf-platform --format '{{"{{"}}.Names{{"}}"}} {{"{{"}}.Status{{"}}"}}' |
        grep -v ' (healthy)' | grep -v '^[^ ]* Up [^(]*$' | grep -v 'analyse-omzetten' | cut -d' ' -f1 | tr '\n' ' ')
      chk containers "Containers gezond" "$([ -z "$bad" ] && echo 1 || echo 0)" red "${bad:-alle containers gezond}"
      code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 http://127.0.0.1:80/health)
      chk http "App antwoordt (/health)" "$([ "$code" = 200 ] && echo 1 || echo 0)" red "http $code"
      if [ "$(env_get PLAATSEN)" != uit ] && [ -f "$SRC/../../api/app/geo/load.py" ]; then
        g=0; geo --check >/dev/null 2>&1 && g=1
        chk geo "Plaatsnamen (geo-bronnen)" "$g" amber "$([ "$g" = 1 ] && echo klaar || echo "ontbreken: platform-ctl.sh geo")"
      fi
      if analyse_on; then
        h=$(docker inspect -f '{{"{{"}}.State.Health.Status{{"}}"}}' cf-platform-analyse-1 2>/dev/null)
        chk analyse "Analyse (gezichten, zoeken op beeld)" "$([ "$h" = healthy ] && echo 1 || echo 0)" amber "${h:-niet gestart}"
      fi
    fi
    # De regels per map gelden voor het hele cluster: alleen hier nakijken.
    if split_on; then
      if mis=$(mapregels_mis 20); then
        chk mapregels "Regels per map (kopieën per bibliotheek)" "$([ -z "$mis" ] && echo 1 || echo 0)" amber \
          "$([ -z "$mis" ] && echo "/blobs-r1/, /blobs-r2/ en /blobs-r3/ staan goed" || echo "ontbreken of anders: $(printf '%s\n' "$mis" | awk '{ printf "%s%s", (NR > 1 ? ", " : ""), $1 }'); platform-ctl.sh mapregels")"
      else
        chk mapregels "Regels per map (kopieën per bibliotheek)" 0 amber "niet te lezen (weed shell, fs.configure)"
      fi
    fi
  fi
  mkdir -p "$STATUS_DIR"
  tmp=$STATUS_DIR/.media-platform.json
  printf '{"app":"media-platform","title":"Mediaplatform","cluster":"%s","version":"%s","ref":"%s","role":"%s","updated_at":"%s","checks":[%s],"values":[%s]}\n' \
    "$CLUSTER" "$rev" "$(jesc "$REF")" "$role" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$CHECKS" "$VALUES" >"$tmp" &&
    mv -f "$tmp" "$STATUS_DIR/media-platform.json"
  [ -n "$STIL" ] || [ "$BAD" = 0 ] || echo "$BAD controle(s) niet in orde"
  return 0
}

case "${1:-}" in
  up)
    # Alleen de node met het VIP draait het platform. Ook als systemd het
    # elders start (een herstart van Docker of keepalived): dan niet starten.
    # Code 3 telt in cf-platform.service als gewoon gestopt (SuccessExitStatus),
    # zodat de unit niet op failed komt en deze node het VIP later nog kan nemen.
    has_vip || { echo "Deze node heeft het VIP $VIP niet: het platform start hier niet." >&2; exit 3; }
    gemount || { echo "$DATA is niet gemount, of de mount antwoordt niet" >&2; exit 1; }
    mappen || exit 1
    if analyse_on; then analyse_dirs || exit 1; fi
    if arr_on; then arr_dirs || exit 1; fi
    # Plaatsnamen: niet fataal; zonder bronnen werkt de rest gewoon.
    geo --check >/dev/null 2>&1 || timeout 300 "$0" geo || true
    # De regels per map van SeaweedFS (kopieën per bibliotheek), vóór de
    # eerste ronde van het platform: niet fataal, en hoogstens drie minuten.
    # Lukt het niet, dan start het platform zonder te verhuizen: een kopie
    # in blobs-r2/ zonder regel kreeg de standaard en wordt later niet
    # opnieuw geschreven. De omgeving wint van --env-file in compose.
    if split_on && ! timeout 180 "$0" mapregels; then
      echo "Let op: de regels per map van SeaweedFS staan niet goed; het platform start toch, maar verhuist niets naar blobs-r1/ tot blobs-r3/ tot de regels er zijn (platform-ctl.sh mapregels, dan systemctl restart cf-platform)" >&2
      export PLATFORM_BLOB_SPLIT=false
    fi
    fingerprint > "$HASH"
    limits_note
    if arr_on; then
      # Eerst de app (op de voorgrond, zoals zonder mediabeheer); qBittorrent
      # en Prowlarr pas na arr-koppel.
      svcs=$(compose config --services | grep -vx -e qbittorrent -e prowlarr -e lidarr)
      [ -n "$svcs" ] || { echo "compose config gaf geen diensten" >&2; exit 1; }
      : > "$ARR_MAG"
      arr_start &
      # shellcheck disable=SC2086
      compose up --no-build --remove-orphans $svcs
    else
      compose up --no-build --remove-orphans
    fi
    ;;
  down)
    # Eerst arr_start van up laten ophouden; startte het qBittorrent en
    # Prowlarr net, dan wacht down daarop (het slot) en stopt ze daarna.
    rm -f "$ARR_MAG"
    compose stop
    ( flock -w 60 9 || echo "Mediabeheer: het slot bleef bezet; toch stoppen" >&2
      arr_stop ) 9>"$ARR_LOCK"
    rm -f "$HASH"
    ;;
  check)
    # Keepalived, om de 3 s. Niets hier mag op FUSE blijven hangen: alles op
    # de mount gaat via fuse (hoogstens 5 s), de markering staat lokaal.
    # Een verfris loopt (mount en platform herstarten): even niets doen.
    systemctl is-active --quiet cf-platform-verfris && exit 0
    systemctl is-active --quiet cf-platform-mount || exit 1
    # Een back-up van deze CT: het VIP afgeven, de mount gaat zo los.
    gepauzeerd && exit 1
    gemount || exit 1
    # Gebruikt weed mount te veel geheugen: netjes herstarten (verfris).
    verfris_nodig && exit 0
    overgestapt || exit 0
    # Draait het platform hier maar faalt het, dan geeft deze node het VIP af.
    systemctl is-failed --quiet cf-platform && exit 1
    if has_vip; then
      if ! systemctl is-active --quiet cf-platform; then
        # Na de overstap (of na een herstart) start de node met het VIP het zelf.
        if start_ok; then systemctl start --no-block cf-platform; fi
      elif mount_nieuwer; then
        echo "weed mount startte opnieuw terwijl het platform draaide: platform herstarten (anders ziet het de oude mount)" >&2
        systemctl restart --no-block cf-platform
      elif ! gezond; then
        # De app hangt: VIP afgeven (notify_fault stopt het platform hier).
        exit 1
      fi
    fi
    exit 0
    ;;
  master)
    if overgestapt && start_ok; then systemctl start --no-block cf-platform; fi
    exit 0
    ;;
  backup)
    systemctl stop --no-block cf-platform
    exit 0
    ;;
  unchanged)
    systemctl is-active --quiet cf-platform || exit 0
    [ "$(cat "$HASH" 2>/dev/null)" = "$(fingerprint)" ]
    ;;
  restart-if-changed)
    systemctl is-active --quiet cf-platform || exit 0
    [ "$(cat "$HASH" 2>/dev/null)" = "$(fingerprint)" ] && exit 0
    # Een nieuwe versie voert bij de start migraties uit: eerst een back-up.
    db_backup
    systemctl restart cf-platform
    ;;
  db-backup) db_backup ;;
  status) shift; status "$@" ;;
  modellen) shift; modellen "$@" ;;
  geo) shift; geo "$@" ;;
  beeld) beeld ;;
  replicatie) shift; replicatie "$@" ;;
  mapregels) shift; mapregels "$@" ;;
  sleutels-klaar) sleutels_klaar ;;
  mount) mount_start ;;
  geheugen) geheugen ;;
  verfris) verfris ;;
  backup-pauze) shift; backup_pauze "$@" ;;
  backup-hervat) backup_hervat ;;
  mappen) mappen ;;
  compose) shift; compose "$@" ;;
  overstap)
    shift
    overstap "$@"
    ;;
  *)
    echo "gebruik: $0 up|down|check|master|backup|unchanged|restart-if-changed|db-backup|status|modellen|geo|replicatie|mapregels|sleutels-klaar|compose|overstap|mount|geheugen|verfris|backup-pauze|backup-hervat|mappen" >&2
    exit 2
    ;;
esac
