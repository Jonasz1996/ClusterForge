# Beheerd door ClusterForge (cluster {{ .cluster.slug }}).
# Bovenop de compose-bestanden van het platform: clustermodus, de database in
# PostgreSQL, en geen herstart door Docker zelf (alleen cf-platform start het,
# op de node met het VIP). Eigen image en project (cf-platform), los van een
# single-node op dezelfde machine.
services:
  platform:
    image: cf-platform:local
    restart: "no"
    environment:
      PLATFORM_MODE: cluster
      PLATFORM_DATABASE_URL: ${PLATFORM_DATABASE_URL:?}
      PLATFORM_CLUSTER_NODES: ${PLATFORM_CLUSTER_NODES:?}
  office:
    restart: "no"
  media:
    image: cf-platform:local
    restart: "no"
