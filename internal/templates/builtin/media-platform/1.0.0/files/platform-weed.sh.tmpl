#!/bin/sh
# Beheerd door ClusterForge (cluster {{ .cluster.slug }}).
# Zet weed uit het image van SeaweedFS op /usr/local/bin, voor de mount.
# Haalt hem uit het image zelf (docker create + cp), dus het hangt niet af
# van een draaiende master. --check: is hij er al, en dezelfde als in het
# image?
set -eu
IMAGE='{{ .params.seaweedfs_image }}'
extract() {
  id=$(docker create "$IMAGE")
  trap 'docker rm -f "$id" >/dev/null 2>&1 || true' EXIT
  docker cp "$id:/usr/bin/weed" "$1"
}
if [ "${1:-}" = --check ]; then
  [ -x /usr/local/bin/weed ] || exit 1
  docker image inspect "$IMAGE" >/dev/null 2>&1 || exit 1
  tmp=$(mktemp)
  extract "$tmp" || { rm -f "$tmp"; exit 1; }
  cmp -s "$tmp" /usr/local/bin/weed; rc=$?
  rm -f "$tmp"
  exit $rc
fi
docker image inspect "$IMAGE" >/dev/null 2>&1 || docker pull "$IMAGE"
extract /usr/local/bin/weed.new
chmod 755 /usr/local/bin/weed.new
mv /usr/local/bin/weed.new /usr/local/bin/weed
/usr/local/bin/weed version
