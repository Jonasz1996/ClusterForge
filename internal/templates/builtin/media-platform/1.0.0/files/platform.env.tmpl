# Beheerd door ClusterForge (cluster {{ .cluster.slug }}). De variabelen van
# de compose-bestanden van het platform, op elke node gelijk behalve NODE_NAME.
DATA_ROOT=/srv/platform-data
NODE_NAME={{ .node.hostname }}
PORT=80
HTTPS_PORT=443
SECURE_COOKIES={{ .params.secure_cookies }}
OFFICE_JWT_SECRET={{ .params.office_jwt_secret }}
OFFICE_LINK_SECRET={{ .params.office_link_secret }}
MEDIA_WORKER_KEY={{ .params.media_worker_key }}
PLATFORM_DATABASE_URL=postgresql+asyncpg://{{ .params.db_user }}:{{ .params.db_password }}@{{ .params.db_vip }}:5432/{{ .params.db_name }}
PLATFORM_CLUSTER_NODES={{ range $i, $n := .nodes }}{{ if $i }},{{ end }}{{ $n.hostname }}={{ $n.address }}{{ end }}
# Plaatsnamen bij foto's (fase 29): de bronnen staan in DATA_ROOT/geo, op de
# gedeelde bestanden; platform-ctl.sh geo haalt ze één keer.
PLAATSEN={{ if .params.places }}aan{{ else }}uit{{ end }}
# Gezichten en zoeken op beeld (platform 0.8.1, fase 29). De modellen staan op
# elke node zelf, de sleutels per eigenaar ook (buiten de gedeelde data); een
# sync zet ze van de VIP-node op de andere nodes. De sleutel van de worker is
# afgeleid van die van media, dus op elke node gelijk.
ANALYSE={{ if .params.analyse }}aan{{ else }}uit{{ end }}
BEELD={{ if .params.beeld }}aan{{ else }}uit{{ end }}
ANALYSE_WORKER_KEY={{ sha256 (print "analyse " .params.media_worker_key) }}
MODELLEN_ROOT=/opt/cf-platform/modellen
SLEUTELS_ROOT=/var/lib/cf-platform/sleutels/gezichten
