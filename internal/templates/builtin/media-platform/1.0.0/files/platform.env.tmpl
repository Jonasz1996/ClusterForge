# Beheerd door ClusterForge (cluster {{ .cluster.slug }}). De variabelen van
# de compose-bestanden van het platform, op elke node gelijk behalve NODE_NAME.
DATA_ROOT=/srv/platform-data
NODE_NAME={{ .node.hostname }}
PORT=80
HTTPS_PORT=443
SECURE_COOKIES={{ .params.secure_cookies }}
OFFICE_JWT_SECRET={{ .params.office_jwt_secret }}
OFFICE_LINK_SECRET={{ .params.office_link_secret }}
MEDIA_WORKER_KEY={{ .params.media_worker_key }}
PLATFORM_DATABASE_URL=postgresql+asyncpg://{{ .params.db_user }}:{{ .params.db_password }}@{{ .params.db_vip }}:5432/{{ .params.db_name }}
PLATFORM_CLUSTER_NODES={{ range $i, $n := .nodes }}{{ if $i }},{{ end }}{{ $n.hostname }}={{ $n.address }}{{ end }}
