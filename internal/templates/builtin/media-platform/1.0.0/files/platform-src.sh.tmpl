#!/bin/sh
# Beheerd door ClusterForge (cluster {{ .cluster.slug }}).
# De code van het platform op de gekozen versie (branch, tag of commit), en
# het image cf-platform:local. Naast een single-node (/opt/platform,
# platform:local), die dit niet raakt. --check: staat de code al op die
# versie en is het image ervan gebouwd?
#
# Een andere versie kiezen gaat in ClusterForge: cluster, Wijzigen, Versie.
# Dan bouwt elke node de nieuwe versie hier, en herstart de node met het VIP
# het platform (platform-ctl.sh restart-if-changed, met eerst een back-up van
# de database).
set -eu
REPO='{{ .params.platform_repo }}'
REF='{{ .params.platform_ref }}'
SRC=/opt/cf-platform/src
STATE=/var/lib/clusterforge/platform-image.rev
# Een commit (7 tot 40 hexadecimale tekens) of een branch/tag?
is_commit() { printf '%s' "$REF" | grep -Eqx '[0-9a-f]{7,40}'; }
want() {
  if is_commit; then
    # Een commit verandert nooit: staat hij al lokaal, dan is dat hem.
    git -C "$SRC" rev-parse -q --verify "$REF^{commit}" 2>/dev/null && return 0
    echo "$REF"
    return 0
  fi
  git ls-remote "$REPO" "refs/heads/$REF" "refs/tags/$REF^{}" "refs/tags/$REF" | head -n 1 | cut -f1
}
if [ "${1:-}" = --check ]; then
  rev=$(want) || exit 1
  head=$(git -C "$SRC" rev-parse HEAD 2>/dev/null) || exit 1
  case "$head" in "$rev"*) ;; *) exit 1 ;; esac
  [ -n "$rev" ] && [ "$(cat "$STATE" 2>/dev/null)" = "$head" ] && docker image inspect cf-platform:local >/dev/null 2>&1
  exit $?
fi
mkdir -p /opt/cf-platform /var/lib/clusterforge
[ -d "$SRC/.git" ] || git clone "$REPO" "$SRC"
if is_commit; then
  # Een volledige commit haalt GitHub rechtstreeks; een korte zoekt in alle
  # branches en tags.
  if [ "${#REF}" = 40 ]; then
    git -C "$SRC" fetch --tags origin "$REF"
  else
    git -C "$SRC" fetch --tags origin '+refs/heads/*:refs/remotes/origin/*'
  fi
  git -C "$SRC" checkout -q --detach "$REF^{commit}"
else
  git -C "$SRC" fetch --tags origin "$REF"
  git -C "$SRC" checkout -q --detach FETCH_HEAD
fi
rev=$(git -C "$SRC" rev-parse HEAD)
S=$SRC/infra/single
docker compose -p cf-platform --project-directory "$S" --env-file /etc/clusterforge/platform.env \
  -f "$S/compose.yaml" -f "$S/compose.office.yaml" -f "$S/compose.media.yaml" \
  -f /etc/clusterforge/platform-cluster.yaml build platform
echo "$rev" > "$STATE"
echo "platform $REF op $rev gebouwd"
