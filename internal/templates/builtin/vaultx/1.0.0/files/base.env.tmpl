# Beheerd door ClusterForge (cluster {{ .cluster.slug }}). Wijzigingen hier
# worden bij de volgende uitrol overschreven. Rechten 0600 (root).
#
# De basis voor /etc/vaultx/vaultx.env: vaultx-ctl.sh voorstart voegt er,
# na een overname, de instellingen van de oude node aan toe (die winnen,
# behalve de database).
VAULTX_DATABASE_URL=postgresql+psycopg://vaultx:{{ .params.db_password }}@{{ .params.db_vip }}:5432/vaultx
{{- if .params.nieuw }}
VAULTX_SECRET_KEY={{ .params.secret_key }}
{{- if .params.public_url }}
VAULTX_PUBLIC_URL={{ .params.public_url }}
{{- end }}
{{- if .params.oidc_issuer }}
VAULTX_OIDC_ISSUER={{ .params.oidc_issuer }}
{{- end }}
{{- if .params.oidc_client_id }}
VAULTX_OIDC_CLIENT_ID={{ .params.oidc_client_id }}
VAULTX_OIDC_CLIENT_SECRET={{ .params.oidc_client_secret }}
{{- end }}
{{- end }}
