# Beheerd door ClusterForge (cluster {{ .cluster.slug }}).
# Nachtelijke back-up van VaultX; alleen de node met het VIP van de
# database ({{ .params.db_vip }}) maakt hem.
[Unit]
Description=Back-up van VaultX ({{ .cluster.slug }})

[Service]
Type=oneshot
ExecStart=/usr/local/lib/clusterforge/vaultx-ctl.sh backup
