# Kopieer naar deploy/.env en pas aan.
POSTGRES_PASSWORD=verander-mij
# Sleutel waarmee de server geheimen (zoals het Proxmox-token) versleutelt. Maak er een met:
#   openssl rand -hex 32
# Bewaar hem ook buiten deze machine: zonder deze sleutel moet je de tokens opnieuw invullen.
CF_MASTER_KEY=
# Adres waarop de server luistert op de host; 127.0.0.1 als je reverse proxy op dezelfde machine draait.
CF_BIND=127.0.0.1
# Zet op false als je (tijdelijk) zonder TLS test; cookies werken anders niet over http.
CF_SECURE_COOKIES=true
# Zet op true als de server alleen via je reverse proxy bereikbaar is, voor juiste IP's in de logs.
CF_TRUST_PROXY_HEADERS=false
# Adres waarop NATS (poort 4222, voor de agents) luistert op de host. Agents moeten dit kunnen bereiken.
CF_NATS_BIND=0.0.0.0
# Hostnaam of IP-adres (eventueel met :poort) waarmee agents NATS bereiken. Leeg: de hostnaam
# waarmee de agent zich aanmeldt. Zet dit als je reverse proxy op een andere machine staat.
CF_NATS_ADVERTISE=
# Adres waarop VictoriaMetrics (poort 8428) luistert op de host, voor een Grafana op een andere
# machine. VictoriaMetrics heeft geen login: open het alleen naar je Grafana.
CF_VM_BIND=127.0.0.1
# Optioneel: links naar Grafana bij elke node en elk cluster. Plaatshouders: {hostname}, {node_id},
# {cluster}, {cluster_id} en {env}. Voorbeeld voor het dashboard Node Exporter Full (id 1860):
# CF_GRAFANA_NODE_URL=https://grafana.example.lan/d/rYdddlPWk/node-exporter-full?var-job=clusterforge&var-node={hostname}
CF_GRAFANA_NODE_URL=
CF_GRAFANA_CLUSTER_URL=
